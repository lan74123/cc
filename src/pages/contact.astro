---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/Prose.astro";

const title = "Contact";
const description = "Get in touch about a project.";
---

<BaseLayout title={title} description={description} is404Page={false}>
  <div class="md:grid md:grid-cols-[1fr_2fr] gap-4 md:px-56">
    <div>
      <h1 class="normal-case font-overpass-mono text-xl m-2">{title}</h1>
    </div>
  </div>
  <Prose>
    <p>Interested in working together? Reach out through any of the channels below.</p>
    <ul>
      <li>Email: <a href="mailto:hello@ccspace.tw">hello@ccspace.tw</a></li>
      <li>Phone: <a href="tel:+886929073788">0929&#8209;073&#8209;788</a></li>
    </ul>
  </Prose>
</BaseLayout>
