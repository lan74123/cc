---
import { SITE_COPYRIGHT_OWNER, SOCIAL_LINKS } from "../consts";

const today = new Date();
---

<footer
  class="md:flex md:justify-between md:items-center md:align-center font-heading w-full md:h-full mt-12"
>
  <div class="text-[12px] text-center items-center flex justify-center">
    {`© ${today.getFullYear()} ${SITE_COPYRIGHT_OWNER}. All rights reserved.`}
  </div>
  <div class="flex justify-center gap-3 m-2 sm:m-0">
    <a
      href={SOCIAL_LINKS.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="p-3 -m-3"
    >
      <span class="sr-only"
        >Go to {SITE_COPYRIGHT_OWNER}'s Instagram Profile</span
      >
      <!-- Material Design Icons "instagram" (Apache 2.0), inline: the
           site's only icon did not need an icon library. -->
      <svg
        viewBox="0 0 24 24"
        class="h-[20px] w-[20px]"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"
        ></path>
      </svg>
    </a>
  </div>
  <slot />
</footer>
