---
// The coming-soon page. Built only when PUBLIC_COMING_SOON=1 (see
// integration.ts), which puts it at `/` and in place of every other page.
// The figure furnishes the route: it fetches a chair, a floor lamp, a side
// table and a plant one by one, admires them, dozes off in the chair when
// nobody is around, and turns the lamp on when the theme goes dark. The
// behaviour is in src/scripts/comingSoon.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Walker from "../components/Walker.astro";
import LogoHeader from "./LogoHeader.astro";
import { SOCIAL_LINKS } from "../consts";
---

<BaseLayout
  title="Coming Soon"
  description="CC Space interior design studio. Our new site is on its way."
  hideHeaderFooter
  noindex
>
  <LogoHeader slot="header" />

  <div class="coming-soon flex flex-col items-center text-center py-10">
    <h1 class="font-heading">Space in progress</h1>
    <p class="cs-sub-en font-body">Our new site is on its way.</p>
    <p class="cs-sub-zh font-body">網站整理中，敬請期待</p>

    <div class="cs-route" id="cs-route" aria-hidden="true">
      <!-- chair -->
      <div class="cs-item" data-slot="22">
        <svg width="18" height="22" viewBox="0 0 18 22" fill="currentColor">
          <rect x="1" y="0" width="3" height="22" rx="1.5"></rect>
          <rect x="1" y="11" width="16" height="3" rx="1.5"></rect>
          <rect x="14" y="11" width="3" height="11" rx="1.5"></rect>
          <rect x="2" y="2" width="4" height="8" rx="2"></rect>
        </svg>
      </div>
      <!-- floor lamp -->
      <div class="cs-item cs-lamp" data-slot="41">
        <div class="cs-glow cs-cone"></div>
        <div class="cs-glow cs-pool"></div>
        <svg width="20" height="38" viewBox="0 0 20 38" fill="currentColor">
          <path
            class="cs-shade"
            d="M6 1h8l4.6 8.6c.4.7-.1 1.4-.9 1.4H2.3c-.8 0-1.3-.7-.9-1.4z"
          ></path>
          <rect x="9" y="11" width="2" height="25" rx="1"></rect>
          <rect x="4" y="35.5" width="12" height="2.5" rx="1.25"></rect>
        </svg>
      </div>
      <!-- side table + vase -->
      <div class="cs-item" data-slot="62">
        <svg width="22" height="25" viewBox="0 0 22 25" fill="currentColor">
          <circle cx="11" cy="9.4" r="3.4"></circle>
          <rect x="10" y="3.5" width="2" height="4" rx="1"></rect>
          <circle cx="11" cy="2.2" r="1.8"></circle>
          <rect x="0" y="13" width="22" height="2.5" rx="1.25"></rect>
          <rect x="2" y="14" width="2.2" height="11" rx="1.1"></rect>
          <rect x="17.8" y="14" width="2.2" height="11" rx="1.1"></rect>
        </svg>
      </div>
      <!-- plant -->
      <div class="cs-item" data-slot="83">
        <svg width="22" height="28" viewBox="0 0 22 28" fill="currentColor">
          <ellipse
            cx="6.5"
            cy="11"
            rx="2.8"
            ry="6.5"
            transform="rotate(-32 6.5 11)"></ellipse>
          <ellipse
            cx="15.5"
            cy="11"
            rx="2.8"
            ry="6.5"
            transform="rotate(32 15.5 11)"></ellipse>
          <ellipse cx="11" cy="8" rx="2.8" ry="7.5"></ellipse>
          <path
            d="M4.5 17h13c.6 0 1 .5.9 1.1l-1.5 8.6c-.1.7-.7 1.3-1.4 1.3H6.5c-.7 0-1.3-.6-1.4-1.3L3.6 18.1c-.1-.6.3-1.1.9-1.1z"
          ></path>
        </svg>
      </div>

      <div class="cs-actor" id="cs-actor" title="Hi!" data-pose="stand">
        <Walker class="cs-walker" furnish />
        <span class="cs-bubble" id="cs-bubble"></span>
      </div>
    </div>

    <a
      class="cs-link font-heading"
      href={SOCIAL_LINKS.instagram}
      target="_blank"
      rel="noopener noreferrer"
    >
      Instagram&nbsp;&nbsp;@ccspace.tw <span class="cs-arrow" aria-hidden="true"
        >→</span
      >
    </a>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  .coming-soon {
    --muted: color-mix(in srgb, var(--ink) 60%, transparent);
    --faint: color-mix(in srgb, var(--ink) 45%, transparent);
    --warm: rgb(255, 206, 128);
  }
  .coming-soon h1 {
    font-size: clamp(30px, 4.6vw, 46px);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .cs-sub-en {
    margin-top: 16px;
    font-size: 15px;
    color: var(--muted);
  }
  .cs-sub-zh {
    margin-top: 6px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  /* The route: one hairline the figure furnishes. */
  .cs-route {
    position: relative;
    width: min(620px, 84vw);
    height: 1px;
    background: var(--line);
    margin: 110px 0 44px;
  }
  .cs-item,
  .cs-actor {
    position: absolute;
    bottom: 0;
    left: 0;
    transform: translateX(-50%);
  }
  .cs-item {
    color: var(--ink);
    opacity: 0;
    transition:
      opacity 0.4s,
      bottom 0.25s ease-in;
  }
  .cs-item.is-on {
    opacity: 1;
  }
  .cs-item.is-held {
    transition: opacity 0.4s;
  }
  .cs-item svg {
    display: block;
  }
  .cs-item.is-fading {
    opacity: 0;
    transition: opacity 0.6s;
  }

  /* Lamp light, dark theme only. */
  .cs-lamp svg {
    position: relative;
  }
  .cs-glow {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .cs-cone {
    bottom: 1px;
    width: 84px;
    height: 26px;
    clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%);
    background: linear-gradient(
      rgba(255, 206, 128, 0.45),
      rgba(255, 206, 128, 0.05)
    );
  }
  .cs-pool {
    width: 120px;
    height: 14px;
    bottom: -7px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(255, 206, 128, 0.4),
      transparent
    );
  }
  .cs-lamp .cs-shade {
    transition: fill 0.4s;
  }
  .cs-lamp.is-lit .cs-glow {
    opacity: 1;
  }
  .cs-lamp.is-lit .cs-shade {
    fill: var(--warm);
  }

  /* The figure. */
  .cs-actor {
    width: 48px;
    height: 48px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .cs-walker {
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 48px;
    height: 48px;
    color: var(--ink);
  }
  .cs-actor.is-left .cs-walker {
    transform: scaleX(-1);
  }
  .cs-actor.is-jump .cs-walker {
    animation: cs-jump 0.5s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  @keyframes cs-jump {
    0%,
    100% {
      translate: 0 0;
    }
    40% {
      translate: 0 -16px;
    }
  }
  .cs-walker .walker-eye {
    fill: var(--paper);
  }
  /* One pose group shows at a time, chosen by data-pose (+ carry/step). */
  .cs-walker > g {
    display: none;
  }
  .cs-actor:not(.is-carry)[data-pose="stand"] .walker-stand,
  .cs-actor:not(.is-carry)[data-pose="walk"]:not(.is-step) .walker-stand,
  .cs-actor:not(.is-carry)[data-pose="walk"].is-step .walker-step,
  .cs-actor.is-carry[data-pose="stand"] .walker-carry,
  .cs-actor.is-carry[data-pose="walk"]:not(.is-step) .walker-carry,
  .cs-actor.is-carry[data-pose="walk"].is-step .walker-carry-step,
  .cs-actor[data-pose="bend"] .walker-bend,
  .cs-actor[data-pose="sit"] .walker-sit,
  .cs-actor[data-pose="lean"] .walker-lean {
    display: inline;
  }
  .cs-actor[data-pose="sit"] .cs-walker {
    animation: cs-breathe 3s ease-in-out infinite;
  }
  @keyframes cs-breathe {
    50% {
      translate: 0 0.6px;
    }
  }

  /* Speech: "!", "♪", "z z z" above the head; the cross bubble beside
     it, tail toward the face. */
  .cs-bubble {
    position: absolute;
    left: 50%;
    bottom: 44px;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    translate: -50% 0;
  }
  .cs-bubble svg {
    width: 22px;
    height: 22px;
    display: block;
  }
  .cs-bubble.is-pop {
    animation: cs-pop 1.4s ease-out forwards;
  }
  .cs-bubble.is-zzz {
    opacity: 1;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.1em;
    animation: cs-zzz 2.6s ease-in-out infinite;
  }
  .cs-bubble.is-side {
    left: calc(50% + 8px);
    bottom: 28px;
    translate: 0 0;
    transform-origin: 0 100%;
  }
  .cs-actor.is-left .cs-bubble.is-side {
    left: auto;
    right: calc(50% + 8px);
    transform-origin: 100% 100%;
  }
  .cs-actor.is-left .cs-bubble.is-side svg {
    transform: scaleX(-1);
  }
  .cs-bubble.is-side.is-pop {
    animation: cs-popside 1.6s ease-out forwards;
  }
  @keyframes cs-pop {
    0% {
      opacity: 0;
      translate: -50% 4px;
    }
    15%,
    70% {
      opacity: 1;
      translate: -50% 0;
    }
    100% {
      opacity: 0;
      translate: -50% -10px;
    }
  }
  @keyframes cs-zzz {
    0% {
      opacity: 0;
      translate: -30% 4px;
    }
    30%,
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 10% -12px;
    }
  }
  @keyframes cs-popside {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    12% {
      opacity: 1;
      transform: scale(1.1);
    }
    20%,
    75% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  .cs-link {
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .cs-arrow {
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .cs-link:hover .cs-arrow {
    transform: translateX(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-bubble,
    .cs-walker {
      animation: none !important;
    }
    .cs-item {
      transition: none;
    }
  }
</style>

<script src="../scripts/comingSoon.ts"></script>
