---
// The coming-soon page. Built only when PUBLIC_COMING_SOON=1 (see
// integration.ts), which puts it at `/` and in place of every other page.
// The figure walks the route, squats to doodle, and gets up again when
// poked.
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Walker from "../components/Walker.astro";
import LogoHeader from "./LogoHeader.astro";
import { SOCIAL_LINKS } from "../consts";
---

<BaseLayout
  title="Coming Soon"
  description="CC Space interior design studio. Our new site is on its way."
  hideHeaderFooter
  noindex
>
  <LogoHeader slot="header" />

  <div class="coming-soon flex flex-col items-center text-center py-12">
    <h1 class="font-heading text-[clamp(28px,4.4vw,44px)] leading-[1.15]">
      Space in progress
    </h1>
    <p class="coming-soon-sub font-body mt-3.5 text-[15px]">
      Our new site is on its way. 網站整理中，敬請期待。
    </p>
    <div class="coming-soon-route">
      <Walker class="coming-soon-walker" />
    </div>
    <a
      class="coming-soon-link font-heading text-sm"
      href={SOCIAL_LINKS.instagram}
      target="_blank"
      rel="noopener noreferrer"
    >
      Follow along on Instagram <span
        class="coming-soon-arrow"
        aria-hidden="true">→</span
      >
    </a>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  .coming-soon h1 {
    letter-spacing: -0.01em;
  }
  .coming-soon-sub {
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }
  /* The route: one hairline, the figure walking it. */
  .coming-soon-route {
    position: relative;
    width: min(560px, 80vw);
    height: 1px;
    background: var(--line);
    margin: 96px 0 48px;
  }
  .coming-soon-walker {
    position: absolute;
    bottom: -6.7px;
    left: 12%;
    width: 40px;
    height: 40px;
    color: var(--ink);
    transform: translateX(-50%);
    cursor: pointer;
  }
  .coming-soon-walker.is-left {
    transform: translateX(-50%) scaleX(-1);
  }
  .coming-soon-walker .walker-eye {
    fill: var(--paper);
  }
  .coming-soon-walker .walker-step {
    display: none;
  }
  .coming-soon-walker .walker-squat {
    visibility: hidden;
  }
  .coming-soon-walker.is-step .walker-stand {
    display: none;
  }
  .coming-soon-walker.is-step .walker-step {
    display: inline;
  }
  .coming-soon-walker.is-squat .walker-stand,
  .coming-soon-walker.is-squat .walker-step {
    display: none;
  }
  .coming-soon-walker.is-squat .walker-squat {
    visibility: visible;
  }
  .coming-soon-link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .coming-soon-arrow {
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .coming-soon-link:hover .coming-soon-arrow {
    transform: translateX(6px);
  }
</style>

<script>
  // The figure picks a spot on the route, walks there (~55px a second),
  // squats to doodle for a while, and sets off again. Clicking it while it
  // doodles sends it off at once. Reduced motion: it sits in the middle,
  // squatting, without the animation.
  let cleanup: () => void = () => {};

  document.addEventListener("astro:page-load", () => {
    cleanup();
    cleanup = () => {};
    const walker = document.querySelector<SVGSVGElement>(".coming-soon-walker");
    const route = walker?.parentElement;
    if (!walker || !route) return;

    let pos = 12;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let frame = 0;
    const place = (): void => {
      walker.style.left = `${pos}%`;
    };

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      pos = 50;
      place();
      walker.classList.add("is-squat");
      return;
    }

    const squat = (ms: number): void => {
      walker.classList.remove("is-step");
      walker.classList.add("is-squat");
      clearTimeout(timer);
      timer = setTimeout(walk, ms);
    };

    const walk = (): void => {
      let target: number;
      do target = 8 + Math.random() * 84;
      while (Math.abs(target - pos) < 18);
      walker.classList.remove("is-squat");
      walker.classList.toggle("is-left", target < pos);
      const speed = 55 / (route.offsetWidth / 100);
      let last = performance.now();
      let flip = 0;
      const tick = (now: number): void => {
        const dt = (now - last) / 1000;
        last = now;
        const dir = Math.sign(target - pos);
        pos += dir * speed * dt;
        if ((dir > 0 && pos >= target) || (dir < 0 && pos <= target)) {
          pos = target;
          place();
          walker.classList.remove("is-left");
          squat(4800 + Math.random() * 4800);
          return;
        }
        flip += dt;
        if (flip > 0.18) {
          walker.classList.toggle("is-step");
          flip = 0;
        }
        place();
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };

    const poke = (): void => {
      if (walker.classList.contains("is-squat")) {
        clearTimeout(timer);
        walk();
      }
    };

    place();
    squat(2400);
    walker.addEventListener("click", poke);
    cleanup = () => {
      clearTimeout(timer);
      cancelAnimationFrame(frame);
      walker.removeEventListener("click", poke);
    };
  });
</script>
