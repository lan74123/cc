    html:is([data-desk="d2"], [data-desk="d3"])[data-list]
      .work-card:not(.is-open)
      h2 {
      opacity: 0.55;
      transition:
        opacity 0.25s ease-out,
        transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
