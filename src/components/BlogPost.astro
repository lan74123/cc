  /* ── Desktop option D2 (html:is([data-desk="d2"], [data-desk="d3"]), dev/preview only): split
     view. The route list keeps the left half; the right half is a pane
     that always shows one project (the first, until another is pointed
     at or clicked). Nothing covers the list, and the empty right side
     becomes the photo. ── */
  @media (min-width: 800px) {
    html:is([data-desk="d2"], [data-desk="d3"])[data-list] .work-list {
      width: 46%;
