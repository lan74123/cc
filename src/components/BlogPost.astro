---
// Row for the works / research index and tag pages: numbered entry under a
// hairline with the photo, title, "category · year", a short description
// and a "View project" link. Pages wrap the rows in `.work-list`.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  url: string;
  image: string | ImageMetadata;
  alt: string;
  description: string;
  category?: string;
  year?: string;
  location?: string;
  positionx: string;
  positiony: string;
  /** 1-based position in the list, shown as "01", "02"... */
  index?: number;
}

const {
  title,
  url,
  image,
  alt,
  description,
  category,
  year,
  location,
  positionx,
  positiony,
  index,
} = Astro.props;
const meta = [category, year].filter(Boolean).join(" · ");
const sub = [category, location].filter(Boolean).join(" · ");
const number = index ? String(index).padStart(2, "0") : "";
const facts = [
  { label: "Location", value: location },
  { label: "Type", value: category },
  { label: "Year", value: year },
].filter((fact) => fact.value);
const detailId = `detail-${url.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}`;
const position = `--position-x: ${positionx || "50%"}; --position-y: ${positiony || "50%"}`;
// The cover's own orientation picks the frame for the large photo, so
// portrait and landscape covers are shown without heavy cropping.
const orient =
  typeof image === "object" && image.height > image.width
    ? "portrait"
    : "landscape";
---

<article class="work-card" data-orient={orient}>
  <a href={url} class="work-card-thumb" tabindex="-1" aria-hidden="true">
    {
      image && (
        <Image
          src={image as ImageMetadata}
          alt={alt}
          width={1400}
          decoding="async"
          format="avif"
          quality={85}
          class="work-card-img"
          style={position}
        />
      )
    }
  </a>
  <div class="work-card-body">
    {number && <span class="work-card-num font-overpass-mono">{number}</span>}
    <h2 class="font-overpass-mono">
      <a href={url}>{title}</a>
    </h2>
    {year && <span class="work-card-year font-overpass-mono">{year}</span>}
    {meta && <p class="work-card-meta font-overpass-mono">{meta}</p>}
    {sub && <p class="work-card-sub font-overpass-mono">{sub}</p>}
    {
      description && (
        <p class="work-card-desc font-inconsolata">{description}</p>
      )
    }
    <a href={url} class="work-card-more font-overpass-mono" tabindex="-1">
      View project <span class="work-card-arrow" aria-hidden="true">→</span>
    </a>
    <button
      type="button"
      class="work-card-toggle font-overpass-mono"
      aria-expanded="false"
      aria-controls={detailId}
    >
      <span class="work-card-toggle-open">Details ↓</span>
      <span class="work-card-toggle-close">Close ↑</span>
    </button>
  </div>
  <div class="work-card-backdrop" aria-hidden="true"></div>
  <div class="work-card-detail" id={detailId}>
    <div class="work-card-detail-head">
      {number && <span class="work-card-num font-overpass-mono">{number}</span>}
      <div>
        <p class="work-card-detail-title font-overpass-mono">{title}</p>
        {meta && <p class="work-card-meta font-overpass-mono">{meta}</p>}
      </div>
      <button type="button" class="work-card-close font-overpass-mono">
        Close
      </button>
    </div>
    {
      image && (
        <a href={url} class="work-card-big">
          <Image
            src={image as ImageMetadata}
            alt={alt}
            width={1920}
            decoding="async"
            loading="lazy"
            format="avif"
            quality={85}
            class="work-card-img"
            style={position}
          />
        </a>
      )
    }
    <p class="work-card-caption font-overpass-mono">
      {number && <span class="work-card-caption-num">{number}</span>}
      {[location, category, year].filter(Boolean).join(" · ")}
    </p>
    <div class="work-card-detail-text">
      {
        facts.length > 0 && (
          <dl class="work-card-facts font-inconsolata">
            {facts.map((fact) => (
              <div>
                <dt class="font-overpass-mono">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <a
        href={url}
        class="work-card-photo-link font-overpass-mono"
        tabindex="-1"
      >
        View project<span class="work-card-photo-arrow" aria-hidden="true"
        ></span>
      </a>
      {
        description && (
          <p class="work-card-detail-desc font-inconsolata">{description}</p>
        )
      }
      <div class="work-card-actions">
        <a href={url} class="work-card-more font-overpass-mono">
          View project <span class="work-card-arrow" aria-hidden="true">→</span>
        </a>
        <button type="button" class="work-card-close-bottom font-overpass-mono">
          <span class="work-card-up-before" aria-hidden="true">↑</span>
          Close
          <span class="work-card-up-after" aria-hidden="true">↑</span>
        </button>
      </div>
    </div>
    <button type="button" class="work-card-cap" aria-label="Close details">
      <svg class="work-card-walker" viewBox="0 0 24 24" aria-hidden="true">
        <g class="walker-stand" fill="currentColor">
          <circle cx="12" cy="6.2" r="3.7"></circle>
          <rect x="9.2" y="10.4" width="5.6" height="6" rx="2.8"></rect>
          <rect x="9.9" y="14.6" width="1.9" height="5.2" rx="0.95"></rect>
          <rect x="12.2" y="14.6" width="1.9" height="5.2" rx="0.95"></rect>
          <rect
            x="7.6"
            y="11"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(12 8.5 11.4)"></rect>
          <rect
            x="14.6"
            y="11"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-12 15.5 11.4)"></rect>
          <circle class="walker-eye" cx="12.9" cy="6" r="0.5"></circle>
          <circle class="walker-eye" cx="14.6" cy="6" r="0.5"></circle>
        </g>
        <g class="walker-step" fill="currentColor">
          <circle cx="12.3" cy="5.8" r="3.7"></circle>
          <rect x="9.4" y="10" width="5.6" height="6" rx="2.8"></rect>
          <rect
            x="10.2"
            y="14.4"
            width="1.9"
            height="5.4"
            rx="0.95"
            transform="rotate(26 11.15 14.8)"></rect>
          <rect
            x="12.3"
            y="14.4"
            width="1.9"
            height="5.4"
            rx="0.95"
            transform="rotate(-26 13.25 14.8)"></rect>
          <rect
            x="7.8"
            y="10.6"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-30 8.7 11)"></rect>
          <rect
            x="14.8"
            y="10.6"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-38 15.7 11)"></rect>
          <circle class="walker-eye" cx="13.2" cy="5.6" r="0.5"></circle>
          <circle class="walker-eye" cx="14.9" cy="5.6" r="0.5"></circle>
        </g>
      </svg>
      <span class="work-card-cap-up" aria-hidden="true">↑</span>
    </button>
  </div>
</article>

<style is:global>
  /* Route geometry: --rx is where the route line runs inside a row,
     --dx where the title (and anything lined up under it) starts. */
  .work-card {
    --rx: 1.125rem;
    --dx: 3rem;
  }
  @media (min-width: 800px) {
    .work-card {
      --rx: 2rem;
      --dx: 6rem;
    }
  }

  /* ── Shared parts ── */
  .work-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    margin-top: 1rem;
  }
  /* Opening and closing rows holds the row in place by script (see
     below); browser scroll anchoring would shift it a second time. */
  html:has(.work-list),
  html:has(.work-list) body {
    overflow-anchor: none;
  }
  @media (min-width: 800px) {
    .work-list {
      gap: 4rem;
    }
  }
  @media (min-width: 1200px) {
    .work-list {
      margin-inline: 6rem;
    }
  }
  .work-card a {
    color: inherit;
    text-decoration: none;
  }
  .work-card-thumb,
  .work-card-big {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(228, 225, 220);
  }
  html.dark .work-card-thumb,
  html.dark .work-card-big {
    background: rgb(48, 47, 52);
  }
  .work-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position-x) var(--position-y);
    transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .work-card:hover .work-card-thumb .work-card-img {
    transform: scale(1.03);
  }
  .work-card-num {
    display: block;
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    opacity: 0.5;
  }
  .work-card-year,
  .work-card-sub,
  .work-card-toggle,
  .work-card-backdrop,
  .work-card-detail,
  .work-card-detail-head {
    display: none;
  }
  .work-card h2 {
    margin-top: 0.35rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .work-card-meta,
  .work-card-sub {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  html.dark .work-card-meta,
  html.dark .work-card-sub {
    opacity: 0.7;
  }
  .work-card-desc,
  .work-card-detail-desc {
    margin-top: 0.85rem;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.65;
    opacity: 0.8;
  }
  .work-card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .work-card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-bottom: 3px;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }
  .work-card-arrow {
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .work-card-more:hover .work-card-arrow,
  .work-card:hover .work-card-body .work-card-arrow {
    transform: translateX(6px);
  }

  /* ── C (default): numbered index rows, each under a hairline ── */
  .work-card {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(34, 33, 37, 0.2);
  }
  html.dark .work-card {
    border-top-color: rgba(245, 245, 245, 0.2);
  }
  @media (min-width: 800px) {
    .work-card {
      display: grid;
      grid-template-columns: 5fr 7fr;
      gap: 3rem;
      padding-top: 2rem;
    }
    .work-card-thumb {
      aspect-ratio: 4 / 3;
    }
    .work-card-body {
      display: grid;
      grid-template-columns: 3.5rem 1fr;
      align-content: start;
    }
    .work-card-body > * {
      grid-column: 2;
    }
    .work-card-num {
      grid-column: 1;
      grid-row: 1;
      margin-top: 0;
      padding-top: 0.6rem;
    }
    .work-card h2 {
      margin-top: 0;
      font-size: 1.75rem;
    }
    .work-card-desc {
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }
    .work-card-more {
      justify-self: start;
      margin-top: 2rem;
    }
  }

  /* ── Preview options (html[data-list], dev only) ── */

  /* G and H families: compact index rows. Number, title and type · year
     on the left, a small square photo on the right. G divides the rows
     with hairlines; H threads them on one vertical route line. */
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-list {
    gap: 0;
    /* <main> centres short pages; keep the index at the top. */
    margin-bottom: auto;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 5.5rem;
    grid-template-areas:
      "num title img"
      ". meta img"
      ". tog img"
      ". detail detail";
    column-gap: 0.75rem;
    row-gap: 0;
    align-items: start;
    padding-block: 1.25rem;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card-body {
    display: contents;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card-body
    > .work-card-num {
    grid-area: num;
    margin-top: 0;
    padding-top: 0.45rem;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card
    h2 {
    grid-area: title;
    margin-top: 0;
    font-size: 1.5rem;
    line-height: 1.15;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card-body
    > .work-card-meta {
    grid-area: meta;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card-thumb {
    grid-area: img;
    aspect-ratio: 1 / 1;
  }
  html:is(
      [data-list="g"],
      [data-list="g1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"],
      [data-list="h"],
      [data-list="h1"]
    )
    .work-card-body
    > :is(.work-card-desc, .work-card-more) {
    display: none;
  }
  html:is([data-list="g"], [data-list="g1"])
    .work-list
    > .work-card:last-of-type {
    border-bottom: 1px solid rgba(34, 33, 37, 0.2);
  }
  html.dark:is([data-list="g"], [data-list="g1"])
    .work-list
    > .work-card:last-of-type {
    border-bottom-color: rgba(245, 245, 245, 0.2);
  }

  /* G and H have no details cue. In G the photo spans just the title and
     type rows; in H an empty row soaks up the photo height so the type
     line stays under the title. */
  html[data-list="g"] .work-card {
    grid-template-areas:
      "num title img"
      ". meta img"
      ". detail detail";
  }
  html[data-list="h"] .work-card {
    grid-template-areas:
      "num title img"
      ". meta img"
      ". . img"
      ". detail detail";
    grid-template-rows: auto auto 1fr auto;
  }

  /* G: on desktop the titles are set large; hovering a row fades the
     others and the project photo follows the cursor. */
  @media (min-width: 800px) {
    html[data-list="g"] .work-card {
      grid-template-columns: 4rem minmax(0, 1fr) auto;
      grid-template-areas: "num title meta";
      align-items: baseline;
      padding-block: 1.75rem;
    }
    html[data-list="g"] .work-card-body > .work-card-num {
      padding-top: 0;
    }
    html[data-list="g"] .work-card h2 {
      font-size: clamp(2.25rem, 4.5vw, 4rem);
      letter-spacing: -0.01em;
      transition: transform 0.45s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    html[data-list="g"] .work-card:hover h2 {
      transform: translateX(1rem);
    }
    html[data-list="g"] .work-card {
      transition: opacity 0.35s ease-out;
    }
    html[data-list="g"] .work-list:hover .work-card:not(:hover) {
      opacity: 0.3;
    }
    html[data-list="g"] .work-card-thumb {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 30;
      width: 22rem;
      aspect-ratio: 4 / 5;
      pointer-events: none;
      opacity: 0;
      transform: translate(
          calc(var(--mx, -999px) + 2rem),
          calc(var(--my, -999px) - 50%)
        )
        scale(0.96);
      transition:
        opacity 0.3s ease-out,
        transform 0.12s linear;
    }
    html[data-list="g"] .work-card:hover .work-card-thumb {
      opacity: 1;
      transform: translate(
          calc(var(--mx, -999px) + 2rem),
          calc(var(--my, -999px) - 50%)
        )
        scale(1);
    }
    html[data-list="g"] .work-card:hover .work-card-img {
      transform: none;
    }
  }

  /* H family: the route. One line runs down through every number, like
     the path you walk through a plan; each project hangs off it. */
  html:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card {
    position: relative;
    border-top: 0;
    padding-block: 1.5rem;
  }
  html:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--rx) - 0.5px);
    border-left: 1px solid rgba(34, 33, 37, 0.3);
    transition: border-color 0.3s ease-out;
  }
  html.dark:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card::before {
    border-left-color: rgba(245, 245, 245, 0.3);
  }
  html:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card:first-child::before {
    top: 1.9rem;
  }
  html:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card:last-of-type:not(.is-open)::before {
    bottom: auto;
    height: 1.9rem;
  }
  html:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card-body
    > .work-card-num {
    position: relative;
    z-index: 1;
    justify-self: center;
    padding: 0.2rem 0;
    font-size: 0.7rem;
    line-height: 1;
    opacity: 1;
    background: rgb(242, 242, 242);
    transition:
      background-color 0.3s ease-out,
      color 0.3s ease-out;
  }
  html.dark:is(
      [data-list="h"],
      [data-list="h1"],
      [data-list="h4-3"],
      [data-list="h5"],
      [data-list="h6"],
      [data-list="h8"],
      [data-list="h9"],
      [data-list="h10"],
      [data-list="h4"]
    )
    .work-card-body
    > .work-card-num {
    background: rgb(34, 33, 37);
  }
  html:is(
      [data-list="h"],
