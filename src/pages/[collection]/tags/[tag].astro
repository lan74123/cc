---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkCard from "../../../components/WorkCard.astro";
import { sortByDate } from "../../../components/sortByDate";
import {
  buildTagPaths,
  getEntries,
  workCardProps,
  type Entry,
} from "../../../scripts/collections";
import {
  ROUTE_COLLECTIONS,
  getRouteCollection,
} from "../../../config/collections";

export async function getStaticPaths() {
  const paths: {
    params: { collection: string; tag: string };
    props: { posts: Entry[]; collectionSlug: string };
  }[] = [];
  for (const config of ROUTE_COLLECTIONS) {
    const entries = await getEntries(config.name);
    for (const tp of buildTagPaths(entries, config.name)) {
      paths.push({
        params: { collection: config.name, ...tp.params },
        props: tp.props,
      });
    }
  }
  return paths;
}

const { tag, collection: collName } = Astro.params;
const { posts, collectionSlug } = Astro.props;
getRouteCollection(collName!); // validates the collection param

const sorted = [...posts].sort(sortByDate);
---

<BaseLayout title={`${tag} -- ${collectionSlug}`} is404Page={false}>
  <h1 class="sr-only">{tag}</h1>
  <div class="work-list">
    {
      sorted.map((post, i) => (
        <WorkCard {...workCardProps(post, collectionSlug, i + 1)} />
      ))
    }
  </div>
</BaseLayout>
