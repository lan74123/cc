# Response headers for Cloudflare Workers static assets.

# Every file under /_astro/ has a content hash in its name, so a changed
# file gets a new URL: browsers may keep these for a year without asking
# again. Pages (HTML) keep the default, revalidated on each visit, so a
# deploy shows at once.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
