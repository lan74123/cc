---
// Project/article hero: photo with the title set below it (no text on the
// image). Parallax: translate3d scroll on an oversized image (top:-20%,
// height:120%), rAF+lerp loop, IntersectionObserver gate,
// prefers-reduced-motion respect, fade-in on load.
// All hooks re-wire on astro:page-load so they survive view transitions.
import Prose from "./Prose.astro";

export interface Props {
  title: string;
  backgroundImage: string;
  mobileBackgroundImage: string;
  positionX?: string;
  positionY?: string;
  alt: string;
}

const {
  title,
  backgroundImage,
  mobileBackgroundImage,
  positionX = "30%",
  positionY = "50%",
  alt,
} = Astro.props;
---

<section class="work-hero">
  <div id="hero-container" class="work-hero-media">
    <div id="hero-parallax" class="absolute inset-0">
      <picture>
        <source media="(min-width: 1200px)" srcset={backgroundImage} />
        <img
          id="hero-image"
          src={mobileBackgroundImage}
          alt={alt}
          fetchpriority="high"
          decoding="sync"
          class="absolute left-0 right-0 w-full object-cover transition-opacity duration-700 opacity-0"
          style={`object-position: ${positionX} ${positionY}; top: -20%; height: 120%;`}
        />
      </picture>
    </div>
  </div>
  <div class="work-hero-text">
    <Prose>
      <h1 class="uppercase font-overpass-mono fade-in-up delay-150">
        {title}
      </h1>
    </Prose>
  </div>
</section>

<style is:global>
  /* Full-bleed photo: negative margins cancel the body padding. */
  .work-hero-media {
    position: relative;
    overflow: hidden;
    height: 72svh;
    margin-inline: -2rem;
  }
  .work-hero-text h1 {
    margin-top: 2.5rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 1200px) {
    .work-hero-media {
      height: 78vh;
      margin-inline: -4rem;
    }
    .work-hero-text h1 {
      margin-top: 3.5rem;
    }
  }
</style>

<script>
  let cleanupHero: () => void = () => {};

  document.addEventListener("astro:page-load", () => {
    cleanupHero();

    // ---- image fade-in ----
    const heroImg = document.getElementById(
      "hero-image",
    ) as HTMLImageElement | null;
    if (heroImg) {
      if (heroImg.complete) {
        heroImg.classList.add("opacity-100");
      } else {
        heroImg.addEventListener(
          "load",
          () => heroImg.classList.add("opacity-100"),
          { once: true },
        );
      }
    }

    // ---- parallax ----
    const container = document.getElementById("hero-container");
    const pEl = document.getElementById("hero-parallax");
    if (!container || !pEl) {
      cleanupHero = () => {};
      return;
    }

    // Collect cleanup actions
    const cleanups: (() => void)[] = [];

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const parallax = pEl;

      let rafId = 0;
      let running = false;
      let currentY = window.scrollY * 0.3;

      function tick() {
        const targetY = window.scrollY * 0.3;
        currentY += (targetY - currentY) * 0.1;
        if (Math.abs(targetY - currentY) < 0.5) {
          currentY = targetY;
          parallax.style.transform = `translate3d(0, ${currentY}px, 0)`;
          running = false;
          return;
        }
        parallax.style.transform = `translate3d(0, ${currentY}px, 0)`;
        rafId = requestAnimationFrame(tick);
      }

      function startLoop() {
        if (!running) {
          running = true;
          rafId = requestAnimationFrame(tick);
        }
      }

      let inView = false;
      function onScroll() {
        if (inView) startLoop();
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            inView = entry.isIntersecting;
            if (inView) {
              parallax.style.willChange = "transform";
              startLoop();
            } else {
              parallax.style.willChange = "auto";
              cancelAnimationFrame(rafId);
              running = false;
            }
          });
        },
        { threshold: 0 },
      );

      observer.observe(container);
      window.addEventListener("scroll", onScroll, { passive: true });

      cleanups.push(() => {
        observer.disconnect();
        window.removeEventListener("scroll", onScroll);
        cancelAnimationFrame(rafId);
        running = false;
        parallax.style.willChange = "auto";
      });
    }

    cleanupHero = () => {
      for (const fn of cleanups) fn();
    };
  });
</script>
