---
// Row for the works / research index and tag pages. The rows hang off one
// route line, each with its number, title and "category · year". Phones:
// a small square photo on the right, and a tap opens the details in
// place (large photo, facts, description, "View project"), with a little
// walking figure on the route to close them. Wide screens: the list keeps
// the left half and the right half is a pane showing one project's photo.
// Pages wrap the rows in `.work-list`. The styles are in WorkList.css and
// the behaviour (opening rows, the pane, the figure) in workList.ts.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Walker from "./Walker.astro";
import "../styles/WorkList.css";

export interface Props {
  title: string;
  url: string;
  image: string | ImageMetadata;
  alt: string;
  description: string;
  category?: string;
  year?: string;
  location?: string;
  positionx: string;
  positiony: string;
  /** 1-based position in the list, shown as "01", "02"... */
  index?: number;
}

const {
  title,
  url,
  image,
  alt,
  description,
  category,
  year,
  location,
  positionx,
  positiony,
  index,
} = Astro.props;
const meta = [category, year].filter(Boolean).join(" · ");
const number = index ? String(index).padStart(2, "0") : "";
const facts = [
  { label: "Location", value: location },
  { label: "Type", value: category },
  { label: "Year", value: year },
].filter((fact) => fact.value);
const position = `object-position: ${positionx || "50%"} ${positiony || "50%"}`;
// The cover's own orientation picks the frame for the large photo, so
// portrait and landscape covers are shown without heavy cropping.
const orient =
  typeof image === "object" && image.height > image.width
    ? "portrait"
    : "landscape";
// The first rows' small photos are on a phone's first screen (the first
// is its largest paint), so they load at once rather than lazily.
const thumbLoading = index !== undefined && index <= 4 ? "eager" : "lazy";
// The large photo covers its frame. On phones the frame follows the
// photo's shape, so the frame's width is enough. The wide-screen pane is
// taller than it is wide (top 6.5rem, bottom 4.5rem; 6rem below 1200px),
// so a landscape photo is cropped at the sides and needs the pane's
// height times its aspect ratio in width.
const aspect = typeof image === "object" ? image.width / image.height : 1.5;
const paneSizes = [
  `(min-width: 1200px) max(calc(54vw - 6rem), calc((100vh - 11rem) * ${aspect.toFixed(3)}))`,
  `(min-width: 800px) max(calc(54vw - 6rem), calc((100vh - 12.5rem) * ${aspect.toFixed(3)}))`,
  "calc(100vw - 7rem)",
].join(", ");
---

<article class="work-card" data-orient={orient}>
  <a href={url} class="work-card-thumb" tabindex="-1" aria-hidden="true">
    {
      image && (
        <Image
          src={image as ImageMetadata}
          alt=""
          widths={[176, 264]}
          sizes="5.5rem"
          loading={thumbLoading}
          decoding="async"
          format="avif"
          quality={85}
          class="work-card-img"
          style={position}
        />
      )
    }
  </a>
  <div class="work-card-body">
    {number && <span class="work-card-num font-heading">{number}</span>}
    <h2 class="font-heading">
      <a href={url}>{title}</a>
    </h2>
    {meta && <p class="work-card-meta font-heading">{meta}</p>}
  </div>
  <div class="work-card-detail">
    {
      image && (
        <a href={url} class="work-card-big">
          <Image
            src={image as ImageMetadata}
            alt={alt}
            widths={[480, 640, 800, 960, 1200, 1600, 1920]}
            sizes={paneSizes}
            decoding="async"
            loading="lazy"
            format="avif"
            quality={85}
            class="work-card-img"
            style={position}
          />
        </a>
      )
    }
    <p class="work-card-caption font-heading">
      {number && <span class="work-card-caption-num">{number}</span>}
      {[location, category, year].filter(Boolean).join(" · ")}
    </p>
    <div class="work-card-detail-text">
      {
        facts.length > 0 && (
          <dl class="work-card-facts font-body">
            {facts.map((fact) => (
              <div>
                <dt class="font-heading">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        description && (
          <p class="work-card-detail-desc font-body">{description}</p>
        )
      }
      <div class="work-card-actions">
        <a href={url} class="work-card-more font-heading">
          View project <span class="work-card-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <button type="button" class="work-card-cap" aria-label="Close details">
      <Walker class="work-card-walker" />
    </button>
  </div>
</article>

<script src="../scripts/workList.ts"></script>
