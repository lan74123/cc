---
// "Discover more" section at the end of a project/article page: the
// whole route of projects in index order, numbered as on the index, with
// this one marked "You are here", plus a link to the full index.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getEntries, type CollectionName } from "../scripts/collections";
import { sortByDate } from "./sortByDate";

export interface Props {
  currentId: string;
  collection: CollectionName;
}

const { currentId, collection } = Astro.props;
const allPosts = await getEntries(collection);
const shouldRender = allPosts.some((post) => post.id !== currentId);
// Keep the route short enough to read on a phone.
const MAX_STOPS = 20;

// The thumbnails are at most 12rem wide (4:3), so 480px covers a 2x
// screen.
async function optimizeImage(src: string | ImageMetadata, alt: string) {
  return await getImage({
    src,
    alt,
    width: 480,
    height: 480,
    fit: "inside",
    format: "avif",
    quality: 70,
    decoding: "async",
  });
}

const ordered = [...allPosts].sort(sortByDate).slice(0, MAX_STOPS);
const hereIndex = ordered.findIndex((post) => post.id === currentId);
const route = await Promise.all(
  ordered.map(async (post, i) => {
    const imageData = post.data.image
      ? await optimizeImage(
          post.data.image.src,
          post.data.image.alt || post.data.title,
        )
      : null;
    return {
      url: `/${collection}/${post.id}/`,
      num: String(i + 1).padStart(2, "0"),
      title: post.data.title,
      meta: [post.data.category, post.data.year].filter(Boolean).join(" · "),
      image: imageData ? imageData.src : null,
      here: i === hereIndex,
      last: i === ordered.length - 1,
    };
  }),
);

const isWorks = collection === "works";
const heading = isWorks ? "Discover more works" : "Discover more research";
const indexLabel = isWorks ? "All works" : "All research";
---

{
  shouldRender && (
    <section
      class="more-section max-w-7xl mx-auto w-full px-24 max-sm:px-5"
      aria-labelledby="more-heading"
    >
      <div class="more-head">
        <h2 id="more-heading" class="font-overpass-mono">
          {heading}
        </h2>
        <a href={`/${collection}/`} class="more-index font-overpass-mono">
          {indexLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
      <ol class="more-route">
        {route.map((stop) => {
          const Row = stop.here ? "div" : "a";
          return (
            <li
              class:list={[
                "route-stop",
                {
                  "is-here": stop.here,
                  "is-last": stop.last,
                },
              ]}
            >
              <Row
                href={stop.here ? undefined : stop.url}
                class="route-row"
                aria-current={stop.here ? "page" : undefined}
              >
                <span class="route-num font-overpass-mono">{stop.num}</span>
                <span class="route-title font-overpass-mono">{stop.title}</span>
                {stop.meta && (
                  <span class="route-meta font-overpass-mono">{stop.meta}</span>
                )}
                {stop.image && (
                  <img
                    class="route-thumb"
                    src={stop.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </Row>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style is:global>
  /* The section opens with a hairline that turns a soft corner and runs
     down into the route, like the route on the index; "All works" and a
     drawn arrow sit on the line at the right. The heading is kept for
     screen readers only; air above does the separating. */
  .more-section {
    --lx: 1.125rem;
    --lpad: 3rem;
    --line: rgba(34, 33, 37, 0.3);
    --paper: rgb(242, 242, 242);
    margin-top: 8rem;
  }
  html.dark .more-section {
    --line: rgba(245, 245, 245, 0.3);
    --paper: rgb(34, 33, 37);
  }
  @media (min-width: 800px) {
    .more-section {
      --lx: 2rem;
      --lpad: 6rem;
    }
  }
  /* Gap option S1 (html[data-gap], dev/preview only; S0 by default):
     a much larger space above, nothing else. */
  html[data-gap="s1"] .more-section {
    margin-top: 10rem;
  }
  @media (min-width: 800px) {
    html[data-gap="s1"] .more-section {
      margin-top: 13rem;
    }
  }
  .more-head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
    padding-left: var(--lpad);
    /* Room for the corner line drawn by ::before. */
    border-top: 1px solid transparent;
  }
  .more-head::before {
    content: "";
    position: absolute;
    top: -1px;
    left: calc(var(--lx) - 0.5px);
    right: 0;
    bottom: -2.25rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    border-top-left-radius: 1.25rem;
    pointer-events: none;
  }
  .more-head h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .more-index {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    /* A 44px-tall target; the words still sit on the line. */
    padding: 1rem 0 1rem 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    /* Softer words on an opaque ground, so the line never shows
       through them. */
    color: color-mix(in srgb, currentColor 80%, transparent);
    background: var(--paper);
    transform: translateY(-50%);
  }
  /* A drawn hairline arrow, the weight of the line it sits on; it
     reaches a little further on hover. */
  .more-index span {
    position: relative;
    width: 2.25rem;
    height: 9px;
    font-size: 0;
    transition: width 0.4s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .more-index span::before {
    content: "";
    position: absolute;
    left: 0;
    right: 1px;
    top: 50%;
    border-top: 1px solid currentColor;
  }
  .more-index span::after {
    content: "";
    position: absolute;
    right: 1px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }
  .more-index:hover span {
    width: 3rem;
  }

  /* The route: every project in index order on one line, numbered as on
     the index, this one marked with a solid number. */
  .more-route {
    display: flex;
    flex-direction: column;
  }
  .route-stop {
    position: relative;
  }
  .route-stop::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--lx) - 0.5px);
    border-left: 1px solid var(--line);
  }
  .route-stop.is-last::before {
    bottom: auto;
    height: 1.9rem;
  }
  .route-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 4.5rem;
    /* The empty 1fr row soaks up the photo height so the title and
       type line stay together. */
    grid-template-areas:
      "num title thumb"
      ". meta thumb"
      ". . thumb";
    grid-template-rows: auto auto 1fr;
    column-gap: 0.75rem;
    align-content: start;
    padding-block: 1.25rem;
    color: inherit;
    text-decoration: none;
  }
  .route-num {
    position: relative;
    z-index: 1;
    grid-area: num;
    align-self: start;
    justify-self: center;
    margin-top: 0.45rem;
    padding: 0.2rem 0;
    font-size: 0.7rem;
    line-height: 1;
    background: var(--paper);
  }
  .route-stop.is-here .route-num {
    padding: 0.3rem 0.35rem;
    border-radius: 2px;
    color: rgb(242, 242, 242);
    background: rgb(34, 33, 37);
  }
  html.dark .route-stop.is-here .route-num {
    color: rgb(34, 33, 37);
    background: rgb(245, 245, 245);
  }
  .route-title {
    grid-area: title;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }
  .route-meta {
    grid-area: meta;
    margin-top: 0.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  /* Photos toned until pointed at, so they read as "next" rather than
     part of this project. */
  .route-thumb {
    grid-area: thumb;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: grayscale(1) sepia(0.35) brightness(0.92);
    transition: filter 0.4s ease-out;
  }
  a.route-row:hover .route-thumb {
    filter: none;
  }
  .route-stop.is-here .route-thumb {
    opacity: 0.5;
  }
  @media (min-width: 800px) {
    .route-row {
      grid-template-columns: 4rem minmax(0, 1fr) 12rem;
      column-gap: 2rem;
      padding-block: 1.75rem;
    }
    .route-title {
      font-size: 1.75rem;
    }
    .route-thumb {
      aspect-ratio: 4 / 3;
    }
  }
</style>
