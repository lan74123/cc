---
/**
 * Project photo gallery.
 *
 * Images are optimized to AVIF via getImage(), shown whole (uncropped) in a
 * centred exhibition column (see MasonryLayout.css), and linked to the
 * custom lightbox for fullscreen viewing with zoom/pan.
 */
import "../styles/MasonryLayout.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface MasonryImage {
  src: string | ImageMetadata;
  alt: string;
}

export interface Props {
  images: Array<MasonryImage | null>;
}

const { images } = Astro.props;
const MAX_W = 1920;
const MAX_H = 1080;

// getImage() reports the requested box (1920x1080) as width/height, not the
// size it actually produces with fit: "inside". Work the real output size
// out from the source so the <img> reserves the right shape before it
// loads. Remote images have no known size and keep the box.
function outputSize(src: string | ImageMetadata) {
  if (typeof src === "string") return { width: MAX_W, height: MAX_H };
  const scale = Math.min(MAX_W / src.width, MAX_H / src.height, 1);
  return {
    width: Math.round(src.width * scale),
    height: Math.round(src.height * scale),
  };
}

const imageAssets = await Promise.all(
  images.map(async (image) => {
    if (image) {
      return await getImage({
        src: image.src,
        alt: image.alt,
        width: MAX_W,
        height: MAX_H,
        fit: "inside",
        decoding: "async",
        format: "avif",
        loading: "lazy",
      });
    }
    return null;
  }),
);
---

<div class="masonry not-prose">
  {
    imageAssets.map((imageAsset, index) => {
      if (!imageAsset) return null;
      const image = images[index]!;
      const size = outputSize(image.src);
      // Orientation lets the layout size portrait and landscape photos
      // differently.
      const orient = size.height > size.width ? "portrait" : "landscape";
      // Link to the original full-resolution asset for the lightbox: for
      // remote images that's the raw src string, for local imports it's
      // ImageMetadata.src (the unprocessed copy Astro emits on import).
      // data-astro-prefetch="false": prefetchAll would otherwise download
      // every multi-MB original as soon as the gallery scrolls into view.
      const fullSizeHref =
        typeof image.src === "string" ? image.src : image.src.src;
      return (
        <div class="image-container gallery" data-orient={orient}>
          <a
            href={fullSizeHref}
            class="image-link lightbox-link"
            data-astro-prefetch="false"
          >
            <img
              src={imageAsset.src}
              alt={imageAsset.attributes.alt}
              loading={imageAsset.attributes.loading}
              decoding={imageAsset.attributes.decoding}
              width={size.width}
              height={size.height}
              class="image"
            />
          </a>
        </div>
      );
    })
  }
</div>
<script src="../scripts/lightbox.ts"></script>
