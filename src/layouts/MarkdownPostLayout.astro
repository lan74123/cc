---
import BaseLayout from "./BaseLayout.astro";
import "../styles/lightbox.css";
import "katex/dist/katex.min.css";
import Prose from "../components/Prose.astro";
import { getImage } from "astro:assets";
import HeroImage from "../components/HeroImage.astro";
import WorkMeta from "../components/WorkMeta.astro";
import NextPost from "../components/NextPost.astro";
import type { CollectionName } from "../scripts/collections";
import type { ImageMetadata } from "astro";

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    author: string;
    tags?: string[];
    image?: {
      src: string | ImageMetadata;
      alt: string;
      positionx?: string;
      positiony?: string;
    };
    pubDate: Date;
    updatedDate?: Date;
    location?: string;
    year?: string;
    client?: string;
  };
  currentId: string;
  collection: CollectionName;
}

const { frontmatter, currentId, collection } = Astro.props;
const title = frontmatter?.title;
const description = frontmatter?.description;
const authorFullName = frontmatter?.author;
const image = frontmatter.image?.src;
const alt = frontmatter.image?.alt;
const positionx = frontmatter?.image?.positionx;
const positiony = frontmatter?.image?.positiony;
const visibleTags = (frontmatter.tags ?? []).filter(
  (tag) => tag.trim().length > 0,
);
const baseUrl = new URL(Astro.request.url).origin;

const backgroundImage = image
  ? await getImage({
      src: image,
      alt: alt,
      width: 3840,
      height: 2160,
      fit: "inside",
      format: "avif",
      quality: 85,
      loading: "eager",
      decoding: "sync",
      fetchpriority: "high",
    })
  : null;

const mobileBackgroundImage = image
  ? await getImage({
      src: image,
      alt: alt,
      width: 1920,
      height: 1080,
      fit: "inside",
      format: "avif",
      quality: 85,
      loading: "eager",
      decoding: "sync",
      fetchpriority: "high",
    })
  : null;

const metaImage = image
  ? await getImage({
      src: image,
      alt: alt,
      width: 1280,
      height: 720,
      decoding: "async",
      format: "webp",
      loading: "lazy",
    })
  : null;
---

<BaseLayout
  title={title}
  image={image ? `${baseUrl}${metaImage?.src}` : undefined}
  alt={alt ?? undefined}
  description={description}
  author={authorFullName}
  pubDate={frontmatter.pubDate}
  updatedDate={frontmatter.updatedDate}
  is404Page={false}
>
  {
    image ? (
      <HeroImage
        title={title}
        tags={visibleTags}
        backgroundImage={backgroundImage!.src}
        mobileBackgroundImage={mobileBackgroundImage!.src}
        positionX={positionx}
        positionY={positiony}
        alt={alt ?? ""}
        collection={collection}
      />
    ) : (
      <div>
        <Prose>
          <h1 class="normal-case font-overpass-mono text-4xl -mb-1 mt-4">
            {title}
          </h1>
          {
            visibleTags.length > 0 && (
              <div class="flex">
                {visibleTags.map((tag) => (
                  <p class="font-overpass-mono text-xl">
                    <a
                      class="bg-slate-600 text-[rgb(245,245,245)] bg-opacity-50 px-2 py-1 rounded-sm no-underline"
                      href={`/${collection}/tags/${tag}`}
                    >
                      {tag}
                    </a>
                  </p>
                ))}
              </div>
            )
          }
        </Prose>
      </div>
    )
  }
  <div>
    <Prose>
      <WorkMeta
        location={frontmatter.location}
        year={frontmatter.year}
        client={frontmatter.client}
      />
      <slot />
    </Prose>
  </div>
  <NextPost currentId={currentId} collection={collection} />
</BaseLayout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    opacity: 0;
    animation: fadeInUp 1s ease-out forwards;
  }

  .delay-150 {
    animation-delay: 150ms;
  }

  .delay-300 {
    animation-delay: 300ms;
  }
</style>
