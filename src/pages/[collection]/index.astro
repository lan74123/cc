---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { sortByDate } from "../../components/sortByDate";
import { getEntries, workCardProps } from "../../scripts/collections";
import {
  ROUTE_COLLECTIONS,
  getRouteCollection,
} from "../../config/collections";

export async function getStaticPaths() {
  return ROUTE_COLLECTIONS.map((c) => ({ params: { collection: c.name } }));
}

const { collection } = Astro.params;
const config = getRouteCollection(collection!);
const posts = await getEntries(config.name);

const sorted = [...posts].sort(sortByDate);
---

<BaseLayout title={config.title} is404Page={false}>
  <h1 class="sr-only">{config.title}</h1>
  <div class="work-list">
    {
      sorted.map((post, i) => (
        <WorkCard {...workCardProps(post, config.name, i + 1)} />
      ))
    }
  </div>
</BaseLayout>
