---
// "Discover more" section at the end of a project/article page: other posts
// in random order on each page load, plus a link to the full index.
// Four portrait cards (two per row on phones), toned until hovered so they
// read as "next" rather than part of the current project.
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionName } from "../scripts/collections";
import logo from "../assets/logo/ccspace_b.svg";

export interface Props {
  currentId: string;
  collection: CollectionName;
}

const { currentId, collection } = Astro.props;
const allPosts = await getCollection(collection);

const otherPosts = allPosts.filter((post) => post.id !== currentId);
const shouldRender = otherPosts.length > 0;
// Limit candidates to avoid serializing the entire collection into HTML
const MAX_CANDIDATES = 20;
// Card slots rendered; unused ones stay hidden.
const SLOTS = 4;

async function optimizeImage(src: string | ImageMetadata, alt: string) {
  return await getImage({
    src,
    alt,
    width: 1280,
    height: 1280,
    fit: "inside",
    format: "avif",
    quality: 70,
    decoding: "async",
  });
}

const postsData = await Promise.all(
  otherPosts.slice(0, MAX_CANDIDATES).map(async (post) => {
    const imageData = post.data.image
      ? await optimizeImage(
          post.data.image.src,
          post.data.image.alt || post.data.title,
        )
      : null;
    return {
      id: post.id,
      title: post.data.title,
      meta: [post.data.category, post.data.year].filter(Boolean).join(" · "),
      image: imageData ? imageData.src : null,
      alt: post.data.image?.alt || post.data.title,
    };
  }),
);

// Placeholder for posts without an image. The logo is an SVG, so it is
// served as-is (no raster transform) and inverted in dark mode via CSS.
const favicon = logo;
const isWorks = collection === "works";
const heading = isWorks ? "Discover more works" : "Discover more research";
const indexLabel = isWorks ? "All works" : "All research";
---

{
  shouldRender && (
    <section
      class="more-section max-w-7xl mx-auto w-full px-24 max-sm:px-5"
      aria-labelledby="more-heading"
    >
      <div class="more-head">
        <h2 id="more-heading" class="font-overpass-mono">
          {heading}
        </h2>
        <a href={`/${collection}/`} class="more-index font-overpass-mono">
          {indexLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div
        id="randomPosts"
        class="more-list"
        data-posts={JSON.stringify(postsData)}
        data-collection={collection}
        data-shown={SLOTS}
        data-favicon={JSON.stringify({
          src: favicon.src,
          width: favicon.width,
          height: favicon.height,
        })}
      >
        {[...Array(SLOTS)].map((_) => (
          <a href="#" class="post-item more-item" hidden>
            <div class="more-thumb">
              <img
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                alt=""
                class="more-img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="font-overpass-mono">
              <span class="more-title" />
            </h3>
            <p class="more-meta font-overpass-mono" />
          </a>
        ))}
      </div>
    </section>
  )
}

<style is:global>
  .more-section {
    margin-top: 6rem;
  }
  .more-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.25rem;
    margin-bottom: 1.75rem;
    border-top: 1px solid rgba(34, 33, 37, 0.35);
  }
  html.dark .more-head {
    border-top-color: rgba(245, 245, 245, 0.3);
  }
  .more-head h2 {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 500;
  }
  @media (min-width: 800px) {
    .more-head h2 {
      font-size: 2.5rem;
    }
  }
  .more-index {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    opacity: 0.65;
    white-space: nowrap;
    transition: opacity 0.2s ease-out;
  }
  .more-index:hover {
    opacity: 1;
  }

  .more-item[hidden] {
    display: none !important;
  }
  .more-item {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .more-thumb {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(228, 225, 220);
  }
  html.dark .more-thumb {
    background: rgb(48, 47, 52);
  }
  .more-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1),
      filter 0.5s ease-out;
  }
  .more-img.is-logo {
    width: 40%;
    height: auto;
    object-fit: contain;
  }
  html.dark .more-img.is-logo {
    filter: invert(1);
  }
  .more-item h3 {
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 500;
  }
  @media (min-width: 800px) {
    .more-item h3 {
      font-size: 1.125rem;
    }
  }
  .more-meta {
    margin-top: 0.15rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .more-meta:empty {
    display: none;
  }
  .more-item:hover .more-img {
    transform: scale(1.03);
  }

  /* Four toned cards; two per row on phones. */
  .more-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 0.75rem;
  }
  @media (min-width: 800px) {
    .more-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .more-img:not(.is-logo) {
    filter: grayscale(1) sepia(0.35) brightness(0.92);
  }
  .more-item:hover .more-img:not(.is-logo) {
    filter: none;
  }
</style>

<script>
  import { shuffle } from "../scripts/utils.ts";

  interface PostData {
    id: string;
    title: string;
    meta: string;
    image: string | null;
    alt: string;
  }

  function updatePosts() {
    const container = document.getElementById("randomPosts");
    if (!container) return;

    const posts: PostData[] = JSON.parse(container.dataset.posts ?? "[]");
    const collection = container.dataset.collection;
    const favicon: { src: string } = JSON.parse(
      container.dataset.favicon ?? "{}",
    );

    const shuffledPosts = shuffle(posts);
    const selectedPosts = shuffledPosts.slice(
      0,
      Number(container.dataset.shown ?? 2),
    );

    const postElements =
      container.querySelectorAll<HTMLAnchorElement>(".post-item");
    selectedPosts.forEach((post, index) => {
      const element = postElements[index];
      if (element) {
        element.href = `/${collection}/${post.id}/`;
        element.hidden = false;

        const img = element.querySelector("img");
        if (img) {
          img.src = post.image || favicon.src;
          img.alt = post.alt;
          img.className = post.image ? "more-img" : "more-img is-logo";
        }

        const title = element.querySelector(".more-title");
        if (title) {
          title.textContent = post.title;
        }

        const meta = element.querySelector(".more-meta");
        if (meta) {
          meta.textContent = post.meta;
        }
      }
    });
  }

  document.addEventListener("astro:page-load", updatePosts);
</script>
