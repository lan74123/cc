---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/Prose.astro";
const pageTitle = "404: Page Not Found";
const message =
  "The page you are looking for may have been moved or no longer exists.";
---

<BaseLayout title={pageTitle} is404Page={false}>
  <Prose>
    <div class="space-y-8 py-16 text-center">
      <h1
        class="font-overpass-mono text-4xl text-gray-900 dark:text-[rgb(245,245,245)]"
      >
        404
      </h1>
      <p
        class="font-overpass-mono text-sm text-center! text-gray-600 dark:text-gray-400"
      >
        {message}
      </p>
      <div
        class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4"
      >
        <a
          href="/works/"
          class="border border-gray-900 dark:border-[rgb(245,245,245)] bg-gray-900 dark:bg-[rgb(245,245,245)] text-white dark:text-gray-900 font-overpass-mono py-2 px-6 rounded-sm inline-block no-underline transition duration-300 ease-in-out hover:opacity-80 text-center"
          data-astro-reload
        >
          Back to Works
        </a>
        <a
          href="/contact/"
          class="border border-gray-900 dark:border-[rgb(245,245,245)] text-gray-900 dark:text-[rgb(245,245,245)] font-overpass-mono py-2 px-6 rounded-sm inline-block no-underline transition duration-300 ease-in-out hover:opacity-80 text-center"
          data-astro-reload
        >
          Contact
        </a>
      </div>
    </div>
  </Prose>
</BaseLayout>
