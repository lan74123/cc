---
// Project facts under the title: a row of labelled columns between hairlines
// (two per row on phones), set apart from the description below.
export interface Props {
  location?: string;
  year?: string;
  client?: string;
  category?: string;
}

const { location, year, client, category } = Astro.props;

const fields = [
  { label: "Location", value: location },
  { label: "Type", value: category },
  { label: "Year", value: year },
  { label: "Client", value: client },
].filter((field) => field.value);
---

{
  fields.length > 0 && (
    <dl class="work-meta font-inconsolata not-prose">
      {fields.map((field) => (
        <div>
          <dt class="font-overpass-mono">{field.label}</dt>
          <dd>{field.value}</dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .work-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-block: 1.25rem;
    margin-bottom: 2rem;
    border-block: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
  }
  :global(html.dark) .work-meta {
    border-color: color-mix(in srgb, var(--ink) 22%, transparent);
  }
  @media (min-width: 800px) {
    .work-meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
      padding-block: 1.5rem;
      margin-bottom: 2.5rem;
    }
  }
  dt {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  :global(html.dark) dt {
    opacity: 0.7;
  }
  dd {
    margin-top: 0.25rem;
    font-size: 1rem;
  }
</style>
