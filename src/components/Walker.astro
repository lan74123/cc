---
// The little figure: standing, mid-step, and squatting to doodle. Used on
// the index rows (WorkCard.astro) and the coming-soon page. Each place
// decides which pose shows (the `walker-stand` / `walker-step` /
// `walker-squat` groups) and colours the eyes (`walker-eye`); the doodling
// animation is shared and lives in the style below.
//
// `furnish` adds the coming-soon page's extra poses: carrying (standing
// and mid-step), bending to pick up or put down, sitting to doze, and
// leaning forward to get up. The index rows leave it off.
export interface Props {
  class?: string;
  furnish?: boolean;
}

const { class: className, furnish = false } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true">
  <g class="walker-stand" fill="currentColor">
    <circle cx="12" cy="6.2" r="3.7"></circle>
    <rect x="9.2" y="10.4" width="5.6" height="6" rx="2.8"></rect>
    <rect x="9.9" y="14.6" width="1.9" height="5.2" rx="0.95"></rect>
    <rect x="12.2" y="14.6" width="1.9" height="5.2" rx="0.95"></rect>
    <rect
      x="7.6"
      y="11"
      width="1.8"
      height="4.2"
      rx="0.9"
      transform="rotate(12 8.5 11.4)"></rect>
    <rect
      x="14.6"
      y="11"
      width="1.8"
      height="4.2"
      rx="0.9"
      transform="rotate(-12 15.5 11.4)"></rect>
    <circle class="walker-eye" cx="12.9" cy="6" r="0.5"></circle>
    <circle class="walker-eye" cx="14.6" cy="6" r="0.5"></circle>
  </g>
  <g class="walker-step" fill="currentColor">
    <circle cx="12.3" cy="5.8" r="3.7"></circle>
    <rect x="9.4" y="10" width="5.6" height="6" rx="2.8"></rect>
    <rect
      x="10.2"
      y="14.4"
      width="1.9"
      height="5.4"
      rx="0.95"
      transform="rotate(26 11.15 14.8)"></rect>
    <rect
      x="12.3"
      y="14.4"
      width="1.9"
      height="5.4"
      rx="0.95"
      transform="rotate(-26 13.25 14.8)"></rect>
    <rect
      x="7.8"
      y="10.6"
      width="1.8"
      height="4.2"
      rx="0.9"
      transform="rotate(-30 8.7 11)"></rect>
    <rect
      x="14.8"
      y="10.6"
      width="1.8"
      height="4.2"
      rx="0.9"
      transform="rotate(-38 15.7 11)"></rect>
    <circle class="walker-eye" cx="13.2" cy="5.6" r="0.5"></circle>
    <circle class="walker-eye" cx="14.9" cy="5.6" r="0.5"></circle>
  </g>
  <g class="walker-squat" fill="currentColor">
    <circle cx="10.2" cy="8" r="3.7"></circle>
    <rect
      x="7.2"
      y="11.2"
      width="5.4"
      height="6.6"
      rx="2.7"
      transform="rotate(14 9.9 14.5)"></rect>
    <rect x="8.4" y="17.6" width="4.4" height="2.8" rx="1.4"></rect>
    <rect
      x="9.6"
      y="15.2"
      width="5.4"
      height="2.2"
      rx="1.1"
      transform="rotate(-24 10.7 16.3)"></rect>
    <rect x="13" y="14.4" width="2" height="6.2" rx="1"></rect>
    <rect
      x="10.6"
      y="12.6"
      width="1.8"
      height="3.4"
      rx="0.9"
      transform="rotate(-60 11.5 13)"></rect>
    <g class="walker-draw">
      <rect
        x="11.1"
        y="12"
        width="1.8"
        height="10"
        rx="0.9"
        transform="rotate(-42.5 12 12.4)"></rect>
    </g>
    <path
      class="walker-doodle"
      d="M19.2 19.65a2.4 0.85 0 1 1 0 1.7a2.4 0.85 0 1 1 0 -1.7"
      pathLength="1"
      fill="none"
      stroke="currentColor"
      stroke-width="0.7"
      stroke-linecap="round"></path>
    <circle class="walker-eye" cx="11.2" cy="8.7" r="0.75"></circle>
    <circle class="walker-eye" cx="13" cy="8.5" r="0.75"></circle>
  </g>
  {
    furnish && (
      <>
        <g class="walker-carry" fill="currentColor">
          <circle cx="11.6" cy="6.1" r="3.7" />
          <rect x="9" y="10.3" width="5.6" height="6" rx="2.8" />
          <rect x="12.4" y="10.6" width="6.6" height="1.9" rx="0.95" />
          <rect
            x="12"
            y="12.3"
            width="6.4"
            height="1.9"
            rx="0.95"
            transform="rotate(6 12.5 13)"
          />
          <circle class="walker-eye" cx="12.6" cy="5.9" r="0.5" />
          <circle class="walker-eye" cx="14.3" cy="5.9" r="0.5" />
          <rect x="9.7" y="14.5" width="1.9" height="5.3" rx="0.95" />
          <rect x="12" y="14.5" width="1.9" height="5.3" rx="0.95" />
        </g>
        <g class="walker-carry-step" fill="currentColor">
          <circle cx="11.6" cy="6.1" r="3.7" />
          <rect x="9" y="10.3" width="5.6" height="6" rx="2.8" />
          <rect x="12.4" y="10.6" width="6.6" height="1.9" rx="0.95" />
          <rect
            x="12"
            y="12.3"
            width="6.4"
            height="1.9"
            rx="0.95"
            transform="rotate(6 12.5 13)"
          />
          <circle class="walker-eye" cx="12.6" cy="5.9" r="0.5" />
          <circle class="walker-eye" cx="14.3" cy="5.9" r="0.5" />
          <rect
            x="10"
            y="14.3"
            width="1.9"
            height="5.5"
            rx="0.95"
            transform="rotate(24 10.95 14.7)"
          />
          <rect
            x="12"
            y="14.3"
            width="1.9"
            height="5.5"
            rx="0.95"
            transform="rotate(-24 12.95 14.7)"
          />
        </g>
        <g class="walker-bend" fill="currentColor">
          <rect x="9.6" y="14.6" width="1.9" height="5.2" rx="0.95" />
          <rect x="11.9" y="14.6" width="1.9" height="5.2" rx="0.95" />
          <rect
            x="8.9"
            y="9.4"
            width="5.6"
            height="6.4"
            rx="2.8"
            transform="rotate(38 11.7 15)"
          />
          <circle cx="16.6" cy="8.4" r="3.6" />
          <rect
            x="14.1"
            y="11"
            width="1.8"
            height="5.4"
            rx="0.9"
            transform="rotate(8 15 11.4)"
          />
          <rect
            x="15.4"
            y="10.8"
            width="1.8"
            height="5.4"
            rx="0.9"
            transform="rotate(-6 16.3 11.2)"
          />
          <circle class="walker-eye" cx="17.6" cy="9.6" r="0.5" />
          <circle class="walker-eye" cx="19" cy="9.1" r="0.5" />
        </g>
        <g class="walker-lean" fill="currentColor">
          <rect x="10.6" y="12.9" width="6.4" height="2.2" rx="1.1" />
          <rect x="15.2" y="13.4" width="2" height="6.4" rx="1" />
          <rect
            x="8.6"
            y="8.4"
            width="5.6"
            height="6.2"
            rx="2.8"
            transform="rotate(35 11.4 14.6)"
          />
          <circle cx="16.9" cy="6.7" r="3.7" />
          <rect
            x="13.8"
            y="10.2"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-30 14.7 10.6)"
          />
          <circle class="walker-eye" cx="17.9" cy="6.9" r="0.5" />
          <circle class="walker-eye" cx="19.3" cy="6.8" r="0.5" />
        </g>
        <g class="walker-sit" fill="currentColor">
          <rect x="9" y="8.6" width="5.6" height="6.2" rx="2.8" />
          <circle cx="12.7" cy="5.5" r="3.7" />
          <rect x="10.6" y="12.9" width="6.4" height="2.2" rx="1.1" />
          <rect x="15.2" y="13.4" width="2" height="6.4" rx="1" />
          <rect
            x="11.6"
            y="10.4"
            width="4.8"
            height="1.8"
            rx="0.9"
            transform="rotate(25 12 11.3)"
          />
          <path
            class="walker-eye-shut"
            d="M13.2 6h1.3M14.9 5.8h1.3"
            stroke-width="0.6"
            stroke-linecap="round"
          />
        </g>
      </>
    )
  }
</svg>

<style is:global>
  /* Asleep (furnish poses): closed eyes in the page colour. */
  .walker-eye-shut {
    stroke: var(--paper);
  }
  /* Squatting: the pencil hand wobbles and the doodle draws itself. */
  .walker-draw {
    transform-box: view-box;
    transform-origin: 12px 12.4px;
    animation: walker-draw 1.2s ease-in-out infinite;
  }
  .walker-doodle {
    stroke-dasharray: 1 1;
    animation: walker-doodle 2.4s linear infinite;
  }
  @keyframes walker-draw {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(5deg) translateY(-0.3px);
    }
    50% {
      transform: rotate(0deg) translateY(0.3px);
    }
    75% {
      transform: rotate(-5deg) translateY(-0.3px);
    }
  }
  @keyframes walker-doodle {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    75% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    95%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .walker-draw,
    .walker-doodle {
      animation: none;
    }
  }
</style>
