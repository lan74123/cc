---
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
import logoDark from "../assets/logo/ccspace_b.svg";
import logoLight from "../assets/logo/ccspace_w.svg";
import { NAV_LINKS, SITE_TITLE } from "../consts";

export interface Props {
  is404Page?: boolean;
}

const { is404Page = false } = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (href: string): boolean => pathname.startsWith(href);
---

<header id="site-header" class="site-header mb-[20px]">
  <nav
    aria-label="Main navigation"
    class="flex items-center justify-between w-full h-[30px]"
  >
    {
      !is404Page && (
        <div class="flex items-center h-[30px]">
          <a href="/works/" class="block" aria-label={`${SITE_TITLE} home`}>
            <img
              class="favicon dark:hidden h-[30px] w-auto"
              src={logoDark.src}
              alt=""
              width="123"
              height="30"
            />
            <img
              class="favicon hidden dark:block h-[30px] w-auto"
              src={logoLight.src}
              alt=""
              width="123"
              height="30"
            />
          </a>
        </div>
      )
    }
    <div class="flex items-center h-[30px] gap-2">
      {
        !is404Page && (
          <>
            <ul class="desktop-nav hidden sm:flex items-center gap-7 mr-5 font-overpass-mono text-[15px]">
              {NAV_LINKS.map((n) => (
                <li>
                  <a
                    href={n.href}
                    aria-current={isCurrent(n.href) ? "page" : undefined}
                  >
                    {n.label}
                  </a>
                </li>
              ))}
            </ul>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <ThemeToggle />
            </div>
            <div class="sm:hidden flex items-center justify-center h-[30px] w-[30px]">
              <Hamburger />
            </div>
          </>
        )
      }
    </div>
  </nav>
  {!is404Page && <Navigation />}
  <slot />
</header>

<style>
  .desktop-nav a {
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.02em;
    opacity: 0.6;
    padding-block: 4px;
    border-bottom: 1px solid transparent;
    transition:
      opacity 0.2s ease-out,
      border-color 0.2s ease-out;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    opacity: 1;
  }

  .desktop-nav a[aria-current="page"] {
    border-bottom-color: currentColor;
  }

  /* Sticky header: stays at the top, slides away while scrolling down and
     returns on the way up. It has a solid page-colour background and a
     smaller logo once off the top, and no rule underneath. Negative
     margins span the body padding so the background runs edge to edge. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    margin-inline: -2rem;
    padding: 16px 2rem 12px;
    margin-top: -2rem;
    background: var(--paper);
    transition: transform 0.35s ease-out;
  }
  @media (min-width: 1200px) {
    .site-header {
      margin-inline: -4rem;
      padding-inline: 4rem;
    }
  }
  /* Keep the mobile menu inset from the screen edge. */
  .site-header :global(.nav-links) {
    right: 2rem;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header .favicon {
    transition: height 0.3s ease-out;
  }
  .site-header.is-scrolled .favicon {
    height: 24px;
  }
</style>

<script>
  let cleanupHeader: () => void = () => {};

  document.addEventListener("astro:page-load", () => {
    cleanupHeader();
    const header = document.getElementById("site-header");
    if (!header) {
      cleanupHeader = () => {};
      return;
    }
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      if (document.documentElement.hasAttribute("data-scroll-hold")) {
        lastY = y;
        return;
      }
      const menuOpen = !!document.querySelector(".nav-links.open");
      header.classList.toggle("is-scrolled", y > 10);
      if (menuOpen || y < 120 || y < lastY - 4) {
        header.classList.remove("is-hidden");
      } else if (y > lastY + 4) {
        header.classList.add("is-hidden");
      }
      if (Math.abs(y - lastY) > 4) lastY = y;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    // Pages that hold content in place by script (WorkCard.astro) set
    // <html data-scroll-hold> meanwhile; those scrolls are not the
    // reader's, so update() only takes the new position as its baseline.
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
    cleanupHeader = () => window.removeEventListener("scroll", onScroll);
  });
</script>
