---
import BaseLayout from "./BaseLayout.astro";
import "../styles/lightbox.css";
import Prose from "../components/Prose.astro";
import { getImage } from "astro:assets";
import HeroImage from "../components/HeroImage.astro";
import WorkMeta from "../components/WorkMeta.astro";
import NextPost from "../components/NextPost.astro";
import Masonry, { type MasonryImage } from "../components/Masonry.astro";
import type { CollectionName } from "../scripts/collections";
import type { ImageMetadata } from "astro";

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    author: string;
    tags?: string[];
    image?: {
      src: string | ImageMetadata;
      alt: string;
      positionx?: string;
      positiony?: string;
    };
    pubDate: Date;
    updatedDate?: Date;
    location?: string;
    year?: string;
    client?: string;
    category?: string;
  };
  currentId: string;
  collection: CollectionName;
  /** Photos shown below the text (galleryFor() in collections.ts). */
  gallery?: MasonryImage[];
}

const { frontmatter, currentId, collection, gallery = [] } = Astro.props;
const title = frontmatter?.title;
const description = frontmatter?.description;
const authorFullName = frontmatter?.author;
const image = frontmatter.image?.src;
const alt = frontmatter.image?.alt;
const positionx = frontmatter?.image?.positionx;
const positiony = frontmatter?.image?.positiony;
const baseUrl = new URL(Astro.request.url).origin;

// Hero photo: one srcset by width, so a portrait cover is as sharp as a
// landscape one on a wide screen (a height cap made portraits only 1620px
// wide). The photo fills a box 100vw wide and, with the 20% parallax
// overscan, 86.4% of the screen high below 1200px (72svh box) and 93.6%
// from 1200px (78vh box), so a landscape cover may need more than 100vw
// of width to cover it; sizes asks for exactly that.
const heroImage = image
  ? await getImage({
      src: image,
      alt: alt,
      width: 1920,
      widths: [640, 960, 1280, 1920, 2560, 3200],
      format: "avif",
      quality: 85,
    })
  : null;
const heroAspect =
  image && typeof image === "object" ? image.width / image.height : 16 / 9;
const heroSizes = [
  `(min-width: 1200px) max(100vw, ${(heroAspect * 93.6).toFixed(1)}vh)`,
  `max(100vw, ${(heroAspect * 86.4).toFixed(1)}svh)`,
].join(", ");

const metaImage = image
  ? await getImage({
      src: image,
      alt: alt,
      width: 1280,
      height: 720,
      decoding: "async",
      format: "webp",
      loading: "lazy",
    })
  : null;
---

<BaseLayout
  title={title}
  image={image ? `${baseUrl}${metaImage?.src}` : undefined}
  alt={alt ?? undefined}
  description={description}
  author={authorFullName}
  pubDate={frontmatter.pubDate}
  updatedDate={frontmatter.updatedDate}
  is404Page={false}
>
  {
    image ? (
      <HeroImage
        title={title}
        src={heroImage!.src}
        srcset={heroImage!.srcSet.attribute}
        sizes={heroSizes}
        positionX={positionx}
        positionY={positiony}
        alt={alt ?? ""}
      />
    ) : (
      <div>
        <Prose>
          <h1 class="uppercase font-heading mt-8">{title}</h1>
        </Prose>
      </div>
    )
  }
  <div>
    <Prose>
      <WorkMeta
        location={frontmatter.location}
        year={frontmatter.year}
        client={frontmatter.client}
        category={frontmatter.category}
      />
      <slot />
      {
        gallery.length > 0 && (
          <>
            <hr />
            <Masonry images={gallery} />
          </>
        )
      }
    </Prose>
  </div>
  <NextPost currentId={currentId} collection={collection} />
</BaseLayout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    opacity: 0;
    animation: fadeInUp 1s ease-out forwards;
  }

  .delay-150 {
    animation-delay: 150ms;
  }
</style>
