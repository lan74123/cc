---
import { render } from "astro:content";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";
import { buildDetailPaths, getEntries } from "../../scripts/collections";
import {
  ROUTE_COLLECTIONS,
  getRouteCollection,
} from "../../config/collections";

export async function getStaticPaths() {
  const paths: {
    params: { collection: string; id: string };
    props: { entry: any };
  }[] = [];
  for (const config of ROUTE_COLLECTIONS) {
    const entries = await getEntries(config.name);
    for (const dp of buildDetailPaths(entries)) {
      paths.push({
        params: { collection: config.name, ...dp.params },
        props: dp.props,
      });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry as any);
---

<MarkdownPostLayout
  frontmatter={entry.data}
  currentId={entry.id}
  collection={getRouteCollection(Astro.params.collection!).name}
>
  <Content />
</MarkdownPostLayout>
