{
  "name": "cc-space",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/sync-readme-versions.js && node scripts/fix-orientation.js",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy:preview": "PUBLIC_PREVIEW=1 bun run build && wrangler deploy --name cc-space-preview",
    "astro": "astro",
    "create": "node scripts/create-content.js",
    "update-post": "node scripts/update-post.js",
    "update": "node scripts/update-post.js",
    "fix-images": "node scripts/fix-orientation.js",
    "clean": "rm -rf .astro node_modules/.astro/data-store.json",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "lint:links": "node scripts/check-links.js",
    "lint:site": "bun run build && bun run lint:html && bun run lint:links"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@erfianugrah/astro-image-hq": "^0.1.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.1",
    "markdown-it": "^14.3.3",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.3.5",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "html-validate": "^9.7.1",
    "inquirer": "^13.4.3",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0",
    "yaml": "^2.9.1"
  }
}
