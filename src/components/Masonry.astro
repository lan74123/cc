---
/**
 * Project photo gallery.
 *
 * Images are optimized to AVIF via getImage(), shown whole (uncropped) in a
 * centred exhibition column (see MasonryLayout.css), and linked to the
 * custom lightbox for fullscreen viewing with zoom/pan.
 */
import "../styles/MasonryLayout.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface MasonryImage {
  src: string | ImageMetadata;
  alt: string;
}

export interface Props {
  images: Array<MasonryImage | null>;
}

const { images } = Astro.props;
// Copies by width for the srcset. Photos show at most 60rem (landscape)
// or 34rem (portrait) wide, so 1920px covers a 2x screen; the lightbox
// opens the original.
const WIDTHS = [480, 800, 1200, 1600, 1920];
// Remote images have no known size; they keep a 1920x1080 box.
const MAX_W = 1920;
const MAX_H = 1080;

// The <img> reserves the photo's shape before it loads.
function outputSize(src: string | ImageMetadata) {
  if (typeof src === "string") return { width: MAX_W, height: MAX_H };
  const scale = Math.min(MAX_W / src.width, 1);
  return {
    width: Math.round(src.width * scale),
    height: Math.round(src.height * scale),
  };
}

const imageAssets = await Promise.all(
  images.map(async (image) => {
    if (!image) return null;
    const common = {
      src: image.src,
      alt: image.alt,
      decoding: "async",
      format: "avif",
      loading: "lazy",
    } as const;
    return typeof image.src === "string"
      ? await getImage({
          ...common,
          width: MAX_W,
          height: MAX_H,
          fit: "inside",
        })
      : await getImage({ ...common, width: 1200, widths: WIDTHS });
  }),
);
---

<div class="masonry not-prose">
  {
    imageAssets.map((imageAsset, index) => {
      if (!imageAsset) return null;
      const image = images[index]!;
      const size = outputSize(image.src);
      // Orientation lets the layout size portrait and landscape photos
      // differently.
      const orient = size.height > size.width ? "portrait" : "landscape";
      // Shown width: the text column (page padding plus the Prose
      // column's own, 2rem + 1.25rem a side on phones, 2rem + 6rem from
      // 800px, 4rem + 6rem from 1200px), capped at 60rem for landscapes
      // and 34rem for portraits (MasonryLayout.css).
      const sizes =
        orient === "portrait"
          ? "(min-width: 800px) 34rem, calc(100vw - 6.5rem)"
          : "(min-width: 1280px) 60rem, (min-width: 1200px) calc(100vw - 20rem), (min-width: 800px) calc(100vw - 16rem), calc(100vw - 6.5rem)";
      // Link to the original full-resolution asset for the lightbox: for
      // remote images that's the raw src string, for local imports it's
      // ImageMetadata.src (the unprocessed copy Astro emits on import).
      // data-astro-prefetch="false": prefetchAll would otherwise download
      // every multi-MB original as soon as the gallery scrolls into view.
      const fullSizeHref =
        typeof image.src === "string" ? image.src : image.src.src;
      return (
        <div class="image-container gallery" data-orient={orient}>
          <a
            href={fullSizeHref}
            class="image-link lightbox-link"
            data-astro-prefetch="false"
          >
            <img
              src={imageAsset.src}
              srcset={imageAsset.srcSet.attribute || undefined}
              sizes={imageAsset.srcSet.attribute ? sizes : undefined}
              alt={imageAsset.attributes.alt}
              loading={imageAsset.attributes.loading}
              decoding={imageAsset.attributes.decoding}
              width={size.width}
              height={size.height}
              class="image"
            />
          </a>
        </div>
      );
    })
  }
</div>
<script src="../scripts/lightbox.ts"></script>
