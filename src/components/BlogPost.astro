---
// Row for the works / research index and tag pages. The rows hang off one
// route line, each with its number, title and "category · year". Phones:
// a small square photo on the right, and a tap opens the details in
// place (large photo, facts, description, "View project"), with a little
// walking figure on the route to close them. Wide screens: the list keeps
// the left half and the right half is a pane showing one project's photo.
// Pages wrap the rows in `.work-list`.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  title: string;
  url: string;
  image: string | ImageMetadata;
  alt: string;
  description: string;
  category?: string;
  year?: string;
  location?: string;
  positionx: string;
  positiony: string;
  /** 1-based position in the list, shown as "01", "02"... */
  index?: number;
}

const {
  title,
  url,
  image,
  alt,
  description,
  category,
  year,
  location,
  positionx,
  positiony,
  index,
} = Astro.props;
const meta = [category, year].filter(Boolean).join(" · ");
const number = index ? String(index).padStart(2, "0") : "";
const facts = [
  { label: "Location", value: location },
  { label: "Type", value: category },
  { label: "Year", value: year },
].filter((fact) => fact.value);
const position = `object-position: ${positionx || "50%"} ${positiony || "50%"}`;
// The cover's own orientation picks the frame for the large photo, so
// portrait and landscape covers are shown without heavy cropping.
const orient =
  typeof image === "object" && image.height > image.width
    ? "portrait"
    : "landscape";
---

<article class="work-card" data-orient={orient}>
  <a href={url} class="work-card-thumb" tabindex="-1" aria-hidden="true">
    {
      image && (
        <Image
          src={image as ImageMetadata}
          alt=""
          widths={[176, 264]}
          sizes="5.5rem"
          decoding="async"
          format="avif"
          quality={85}
          class="work-card-img"
          style={position}
        />
      )
    }
  </a>
  <div class="work-card-body">
    {number && <span class="work-card-num font-overpass-mono">{number}</span>}
    <h2 class="font-overpass-mono">
      <a href={url}>{title}</a>
    </h2>
    {meta && <p class="work-card-meta font-overpass-mono">{meta}</p>}
  </div>
  <div class="work-card-detail">
    {
      image && (
        <a href={url} class="work-card-big">
          <Image
            src={image as ImageMetadata}
            alt={alt}
            widths={[480, 800, 1200, 1600, 1920]}
            sizes="(min-width: 800px) calc(54vw - 6rem), calc(100vw - 7rem)"
            decoding="async"
            loading="lazy"
            format="avif"
            quality={85}
            class="work-card-img"
            style={position}
          />
        </a>
      )
    }
    <p class="work-card-caption font-overpass-mono">
      {number && <span class="work-card-caption-num">{number}</span>}
      {[location, category, year].filter(Boolean).join(" · ")}
    </p>
    <div class="work-card-detail-text">
      {
        facts.length > 0 && (
          <dl class="work-card-facts font-inconsolata">
            {facts.map((fact) => (
              <div>
                <dt class="font-overpass-mono">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        description && (
          <p class="work-card-detail-desc font-inconsolata">{description}</p>
        )
      }
      <div class="work-card-actions">
        <a href={url} class="work-card-more font-overpass-mono">
          View project <span class="work-card-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <button type="button" class="work-card-cap" aria-label="Close details">
      <svg class="work-card-walker" viewBox="0 0 24 24" aria-hidden="true">
        <g class="walker-stand" fill="currentColor">
          <circle cx="12" cy="6.2" r="3.7"></circle>
          <rect x="9.2" y="10.4" width="5.6" height="6" rx="2.8"></rect>
          <rect x="9.9" y="14.6" width="1.9" height="5.2" rx="0.95"></rect>
          <rect x="12.2" y="14.6" width="1.9" height="5.2" rx="0.95"></rect>
          <rect
            x="7.6"
            y="11"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(12 8.5 11.4)"></rect>
          <rect
            x="14.6"
            y="11"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-12 15.5 11.4)"></rect>
          <circle class="walker-eye" cx="12.9" cy="6" r="0.5"></circle>
          <circle class="walker-eye" cx="14.6" cy="6" r="0.5"></circle>
        </g>
        <g class="walker-step" fill="currentColor">
          <circle cx="12.3" cy="5.8" r="3.7"></circle>
          <rect x="9.4" y="10" width="5.6" height="6" rx="2.8"></rect>
          <rect
            x="10.2"
            y="14.4"
            width="1.9"
            height="5.4"
            rx="0.95"
            transform="rotate(26 11.15 14.8)"></rect>
          <rect
            x="12.3"
            y="14.4"
            width="1.9"
            height="5.4"
            rx="0.95"
            transform="rotate(-26 13.25 14.8)"></rect>
          <rect
            x="7.8"
            y="10.6"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-30 8.7 11)"></rect>
          <rect
            x="14.8"
            y="10.6"
            width="1.8"
            height="4.2"
            rx="0.9"
            transform="rotate(-38 15.7 11)"></rect>
          <circle class="walker-eye" cx="13.2" cy="5.6" r="0.5"></circle>
          <circle class="walker-eye" cx="14.9" cy="5.6" r="0.5"></circle>
        </g>
        <g class="walker-squat" fill="currentColor">
          <circle cx="10.2" cy="8" r="3.7"></circle>
          <rect
            x="7.2"
            y="11.2"
            width="5.4"
            height="6.6"
            rx="2.7"
            transform="rotate(14 9.9 14.5)"></rect>
          <rect x="8.4" y="17.6" width="4.4" height="2.8" rx="1.4"></rect>
          <rect
            x="9.6"
            y="15.2"
            width="5.4"
            height="2.2"
            rx="1.1"
            transform="rotate(-24 10.7 16.3)"></rect>
          <rect x="13" y="14.4" width="2" height="6.2" rx="1"></rect>
          <rect
            x="10.6"
            y="12.6"
            width="1.8"
            height="3.4"
            rx="0.9"
            transform="rotate(-60 11.5 13)"></rect>
          <g class="walker-draw">
            <rect
              x="11.1"
              y="12"
              width="1.8"
              height="10"
              rx="0.9"
              transform="rotate(-42.5 12 12.4)"></rect>
          </g>
          <path
            class="walker-doodle"
            d="M19.2 19.65a2.4 0.85 0 1 1 0 1.7a2.4 0.85 0 1 1 0 -1.7"
            pathLength="1"
            fill="none"
            stroke="currentColor"
            stroke-width="0.7"
            stroke-linecap="round"></path>
          <circle class="walker-eye" cx="11.2" cy="8.7" r="0.75"></circle>
          <circle class="walker-eye" cx="13" cy="8.5" r="0.75"></circle>
        </g>
      </svg>
    </button>
  </div>
</article>

<style is:global>
  /* ── The route ──
     One line runs down through every number, like the path you walk
     through a plan; each project hangs off it. --rx is where the line
     runs inside a row, --dx where the title (and anything lined up under
     it) starts. */
  .work-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: 1rem;
    /* <main> centres short pages; keep the index at the top. */
    margin-bottom: auto;
  }
  /* Opening and closing a row holds it in place by script (see below);
     browser scroll anchoring would shift it a second time. */
  html:has(.work-list),
  html:has(.work-list) body {
    overflow-anchor: none;
  }
  .work-card {
    --rx: 1.125rem;
    --dx: 3rem;
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 5.5rem;
    /* The empty 1fr row soaks up the photo height so the type line stays
       under the title. */
    grid-template-areas:
      "num title img"
      ". meta img"
      ". . img"
      ". detail detail";
    grid-template-rows: auto auto 1fr auto;
    column-gap: 0.75rem;
    align-items: start;
    padding-block: 1.5rem;
    cursor: pointer;
    /* Rows scrolled back to on close clear the sticky header. */
    scroll-margin-top: 4.5rem;
    transition: background-color 0.25s ease-out;
  }
  .work-card a {
    color: inherit;
    text-decoration: none;
  }
  /* No grey tap flash on iOS; the rows give their own feedback. */
  .work-card,
  .work-card a,
  .work-card button {
    -webkit-tap-highlight-color: transparent;
  }
  .work-card::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--rx) - 0.5px);
    border-left: 1px solid rgba(34, 33, 37, 0.3);
    transition: border-color 0.3s ease-out;
  }
  html.dark .work-card::before {
    border-left-color: rgba(245, 245, 245, 0.3);
  }
  /* The line starts at the first number and ends at the last (on
     phones, an open last row runs it on down its details). */
  .work-card:first-child::before {
    top: 1.9rem;
  }
  @media (max-width: 799px) {
    .work-card:last-of-type:not(.is-open)::before {
      bottom: auto;
      height: 1.9rem;
    }
  }
  .work-card-body {
    display: contents;
  }
  .work-card-num {
    position: relative;
    z-index: 1;
    grid-area: num;
    justify-self: center;
    padding: 0.2rem 0;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.1em;
    /* Page colour behind the number, so the line breaks around it. */
    background: rgb(242, 242, 242);
    transition:
      background-color 0.3s ease-out,
      color 0.3s ease-out;
  }
  html.dark .work-card-num {
    background: rgb(34, 33, 37);
  }
  .work-card h2 {
    grid-area: title;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }
  .work-card-meta {
    grid-area: meta;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  html.dark .work-card-meta {
    opacity: 0.7;
  }
  .work-card-thumb,
  .work-card-big {
    display: block;
    overflow: hidden;
    background: rgb(228, 225, 220);
  }
  html.dark .work-card-thumb,
  html.dark .work-card-big {
    background: rgb(48, 47, 52);
  }
  .work-card-thumb {
    grid-area: img;
    aspect-ratio: 1 / 1;
  }
  .work-card-big {
    aspect-ratio: 4 / 5;
  }
  .work-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .work-card:hover .work-card-thumb .work-card-img {
    transform: scale(1.03);
  }
  /* A row that has just folded shut: its small photo fades back in. */
  .work-card.is-settling .work-card-thumb {
    animation: settle-in 0.45s ease-out;
  }
  @keyframes settle-in {
    from {
      opacity: 0;
    }
  }

  /* ── The details: hidden until a row opens. Phones show them in place,
     wide screens in the pane (further down). ── */
  .work-card-detail,
  .work-card-caption,
  .work-card-cap,
  .work-walker-d2 {
    display: none;
  }
  .work-card-facts {
    display: grid;
    /* Place names run longest and years shortest, so the columns are
       weighted that way, keeping an even gap between the values. */
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 0.65fr);
    gap: 1rem 1.25rem;
    padding-block: 0.9rem;
    border-block: 1px solid rgba(34, 33, 37, 0.15);
  }
  html.dark .work-card-facts {
    border-color: rgba(245, 245, 245, 0.18);
  }
  .work-card-facts dt {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .work-card-facts dd {
    margin-top: 0.2rem;
    font-size: 0.9rem;
  }
  .work-card-detail-desc {
    margin-top: 0.85rem;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.65;
    opacity: 0.8;
  }
  .work-card-actions {
    display: flex;
    align-items: flex-end;
    gap: 2rem;
  }
  .work-card-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-bottom: 3px;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }
  .work-card-arrow {
    display: inline-block;
    transition: transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }
  .work-card-more:hover .work-card-arrow {
    transform: translateX(6px);
  }
  /* The figure: standing, mid-step, and squatting to doodle. */
  .work-card-walker .walker-squat {
    display: none;
  }
  .walker-draw {
    transform-box: view-box;
    transform-origin: 12px 12.4px;
    animation: walker-draw 1.2s ease-in-out infinite;
  }
  .walker-doodle {
    stroke-dasharray: 1 1;
    animation: walker-doodle 2.4s linear infinite;
  }
  @keyframes walker-draw {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(5deg) translateY(-0.3px);
    }
    50% {
      transform: rotate(0deg) translateY(0.3px);
    }
    75% {
      transform: rotate(-5deg) translateY(-0.3px);
    }
  }
  @keyframes walker-doodle {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    75% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    95%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .walker-draw,
    .walker-doodle {
      animation: none;
    }
  }
  @keyframes work-open {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Phones and tablets: a tap opens the row in place, on the title
     line. The open number becomes a solid "you are here" marker, and
     "View project" stands on a rule that branches off the route. The
     little figure is the way back: it rides the route with the reader,
     steps as the page scrolls, and closes the row when tapped. ── */
  @media (max-width: 799px) {
    .work-card:active:not(.is-open) {
      background-color: rgba(34, 33, 37, 0.04);
    }
    html.dark .work-card:active:not(.is-open) {
      background-color: rgba(245, 245, 245, 0.05);
    }
    .work-card.is-open .work-card-num {
      padding: 0.3rem 0.35rem;
      border-radius: 2px;
      color: rgb(242, 242, 242);
      background: rgb(34, 33, 37);
    }
    html.dark .work-card.is-open .work-card-num {
      color: rgb(34, 33, 37);
      background: rgb(245, 245, 245);
    }
    .work-card.is-open .work-card-thumb {
      display: none;
    }
    .work-card-detail {
      position: relative;
    }
    .work-card.is-open .work-card-detail {
      display: block;
      grid-area: detail;
      margin-top: 1.25rem;
      animation: work-open 0.5s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    /* The large photo frame follows the cover: 4:5 portrait, 3:2
       landscape. */
    .work-card[data-orient="landscape"] .work-card-big {
      aspect-ratio: 3 / 2;
    }
    .work-card[data-orient="portrait"] .work-card-big {
      aspect-ratio: 4 / 5;
    }
    .work-card.is-open .work-card-detail-text {
      margin-top: 1.6rem;
    }
    /* "View project" on the rule that leaves the route at the foot. */
    .work-card-actions {
      position: relative;
      justify-content: flex-end;
      margin-top: 2rem;
    }
    .work-card-actions::before {
      content: "";
      position: absolute;
      left: calc(var(--rx) - var(--dx) - 0.5px);
      right: 0;
      bottom: 0;
      border-top: 1px solid currentColor;
    }
    .work-card-actions > .work-card-more {
      margin-top: 0;
      padding-bottom: 0.6rem;
      border-bottom: 0;
    }
    /* The figure is sticky, so it rides the lit line just above the
       visible bottom of the screen until the junction at the foot
       scrolls into view, and never climbs above the top of the details.
       Its negative margins take no room and centre it on the details'
       bottom edge. --cap-gap (set by script from the visual viewport)
       keeps it clear of Safari's toolbar on iPhone. */
    .work-card-cap {
      position: sticky;
      bottom: var(--cap-gap, 20px);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      margin: -1.375rem 0 -1.375rem calc(var(--rx) - var(--dx) - 1.375rem);
      padding: 0;
      color: inherit;
      background: rgb(242, 242, 242);
      border: 1px solid currentColor;
      border-radius: 50%;
      cursor: pointer;
      transition:
        background-color 0.2s ease-out,
        color 0.2s ease-out;
    }
    html.dark .work-card-cap {
      background: rgb(34, 33, 37);
    }
    .work-card-cap:active {
      color: rgb(242, 242, 242);
      background: rgb(34, 33, 37);
    }
    html.dark .work-card-cap:active {
      color: rgb(34, 33, 37);
      background: rgb(245, 245, 245);
    }
    /* On "View project" it walks along the line to it. */
    .work-card-cap.is-leaving {
      transition: transform 0.6s linear;
    }
    /* A row folding away because one further down was opened: its
       figure steps back at once, so only one figure is on the route. */
    .work-card.is-handoff .work-card-cap {
      visibility: hidden;
    }
    .work-card-walker {
      width: 2rem;
      height: 2rem;
      transition: transform 0.2s ease-out;
    }
    .work-card-walker .walker-step,
    .work-card-cap.is-step .walker-stand {
      display: none;
    }
    .work-card-cap.is-step .walker-step {
      display: inline;
    }
    .work-card-cap.is-left .work-card-walker {
      transform: scaleX(-1);
    }
    /* Eyes in the page colour, swapped when the figure is pressed. */
    .walker-eye {
      fill: rgb(242, 242, 242);
    }
    html.dark .walker-eye,
    .work-card-cap:active .walker-eye {
      fill: rgb(34, 33, 37);
    }
    html.dark .work-card-cap:active .walker-eye {
      fill: rgb(245, 245, 245);
    }
  }

  /* ── Wide screens: split view. The route list keeps the left half; the
     right half is a pane that always shows one project (the first, until
     another is pointed at or clicked). As on Herzog & de Meuron's index,
     the row itself is the way in: pointing at it underlines the title,
     and clicking anywhere on it opens the project. A single figure walks
     the route to the row shown in the pane. ── */
  @media (min-width: 800px) {
    .work-card {
      --rx: 2rem;
      --dx: 6rem;
      grid-template-columns: 4rem minmax(0, 1fr);
      grid-template-areas:
        "num title"
        ". meta";
      grid-template-rows: auto auto;
      column-gap: 2rem;
      padding-block: 1.6rem;
    }
    .work-list {
      position: relative;
      width: 46%;
      padding-top: 1.5rem;
    }
    /* Before anything is chosen (.is-idle) the figure waits at the start
       of the route, a little above 01, where the line begins. */
    .work-card:first-child::before {
      top: -0.75rem;
    }
    /* The rows never grow here (the details are in the pane), so the
       route always ends at the last number, open or not. */
    .work-card:last-of-type::before {
      bottom: auto;
      height: 2.7rem;
    }
    .work-card-thumb,
    .work-card-actions,
    .work-card-facts,
    .work-card-detail-desc {
      display: none;
    }
    .work-card h2 {
      font-size: 2rem;
      transition: transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .work-card.is-open h2 {
      transform: translateX(0.75rem);
    }
    .work-card:not(.is-open) h2 {
      opacity: 0.55;
      transition:
        opacity 0.25s ease-out,
        transform 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .work-card:not(.is-open):hover h2 {
      opacity: 1;
    }
    .work-card h2 a {
      text-decoration: underline 1px transparent;
      text-underline-offset: 0.3em;
      transition: text-decoration-color 0.25s ease-out;
    }
    .work-card:hover h2 a,
    .work-card:has(.work-card-big:hover) h2 a {
      text-decoration-color: currentColor;
    }
    /* With nothing chosen yet, no row looks chosen: every title is lit,
       none is pushed in. The pane still shows the first project. */
    .work-list.is-idle .work-card h2 {
      opacity: 1;
      transform: none;
    }
    /* Touch: no hover, so the row shown in the pane keeps its title
       underlined, a sign that tapping it again goes in. */
    @media (hover: none) {
      .work-list:not(.is-idle) .work-card.is-open h2 a {
        text-decoration-color: currentColor;
      }
    }

    /* The pane: always fits the screen, so it never scrolls. The photo
       takes whatever height the caption leaves. Every project's pane is
       laid in the same place; only the open one shows. Changing project
       cross-fades the two, the old one going a little quicker than the
       new one arrives, so the photo eases from one room to the next
       instead of jumping. */
    .work-card-detail {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 6.5rem;
      right: 4rem;
      bottom: 4.5rem;
      width: calc(54% - 6rem);
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0.45s ease-in,
        visibility 0s linear 0.45s;
    }
    .work-card.is-open .work-card-detail {
      z-index: 1;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    /* Below 1200px the footer stacks its two lines; keep the pane clear
       of it. */
    @media (max-width: 1199px) {
      .work-card-detail {
        bottom: 6rem;
      }
    }
    .work-card-big {
      flex: 1 1 auto;
      min-height: 8rem;
      width: 100%;
      aspect-ratio: auto;
    }
    .work-card-big img {
      transition: transform 1.2s cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    .work-card.is-open:hover .work-card-big img {
      transform: scale(1.02);
    }
    /* Under the photo, one line: the row's number, then place, type and
       year. */
    .work-card-caption {
      display: flex;
      flex: none;
      gap: 1.5rem;
      margin: 1rem 0 0;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.75;
    }
    .work-card-detail-text {
      flex: none;
    }

    /* The number keeps its place until the figure arrives, then the
       figure stands in for it; it comes back at once when the figure
       leaves. While idle, 01 shows. */
    .work-card.is-open .work-card-num {
      visibility: hidden;
      transition: visibility 0s linear 0.55s;
    }
    .work-list.is-idle .work-card.is-open .work-card-num {
      visibility: visible;
      transition: none;
    }
    .work-walker-d2 {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      color: inherit;
      border: 1px solid currentColor;
      border-radius: 50%;
      background: rgb(242, 242, 242);
      pointer-events: none;
      transform: translate(var(--wx, 0px), var(--wy, 0px));
      transition: transform 0.6s cubic-bezier(0.45, 0, 0.25, 1);
    }
    html.dark .work-walker-d2 {
      background: rgb(34, 33, 37);
    }
    .work-walker-d2 .work-card-walker {
      width: 2rem;
      height: 2rem;
    }
    .work-walker-d2 .walker-step,
    .work-walker-d2.is-step .walker-stand {
      display: none;
    }
    .work-walker-d2.is-step .walker-step {
      display: inline;
    }
    .work-walker-d2.is-left .work-card-walker {
      transform: scaleX(-1);
    }
    .work-walker-d2 .walker-eye {
      fill: rgb(242, 242, 242);
    }
    html.dark .work-walker-d2 .walker-eye {
      fill: rgb(34, 33, 37);
    }
    /* Idle: the figure squats at the start of the route, idly drawing
       circles on the ground. Bored: it does the same where it stands
       when a shown row is left unopened a while. */
    .work-list.is-idle .work-walker-d2 .walker-stand,
    .work-list.is-idle .work-walker-d2 .walker-step,
    .work-walker-d2.is-bored .walker-stand,
    .work-walker-d2.is-bored .walker-step {
      display: none;
    }
    /* The squat is always laid out and only hidden, so its drawing keeps
       running: Safari does not start an SVG animation that comes back
       from display: none, and the figure squatted with a still circle. */
    .work-walker-d2 .work-card-walker .walker-squat {
      display: inline;
      visibility: hidden;
    }
    .work-list.is-idle .work-walker-d2 .walker-squat,
    .work-walker-d2.is-bored .walker-squat {
      visibility: visible;
    }
  }
  /* Arriving on the page, the open row and the figure are set in place at
     once; only later changes animate. */
  .work-list[data-still] .work-walker-d2,
  .work-list[data-still] .work-card h2,
  .work-list[data-still] .work-card-num {
    transition: none !important;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  // Phones and tablets (H9): tapping a row opens its details in place,
  // one row at a time. Opening or closing changes the page height above
  // and below, so the row the reader acted on is held in place on screen
  // (Safari has no CSS scroll anchoring to do it). Wide screens (D3):
  // the list keeps the left half and a pane on the right shows one row.
  let cleanupList: () => void = () => {};

  document.addEventListener("astro:page-load", () => {
    cleanupList();
    const list = document.querySelector<HTMLElement>(".work-list");
    if (!list) {
      cleanupList = () => {};
      return;
    }
    const root = document.documentElement;
    const wide = window.matchMedia("(min-width: 800px)");
    // The split view (D3) is in use.
    const split = () => wide.matches;

    const setOpen = (card: Element, open: boolean) => {
      card.classList.toggle("is-open", open);
    };
    const closeAll = () => {
      list.querySelectorAll(".work-card.is-open").forEach((card) => {
        setOpen(card, false);
      });
    };
    // Run a change, then scroll so `anchor` sits where it was on screen.
    // Mark scrolls made here so the header does not react to them.
    let holdTimer = 0;
    const hold = () => {
      root.setAttribute("data-scroll-hold", "");
      window.clearTimeout(holdTimer);
      holdTimer = window.setTimeout(
        () => root.removeAttribute("data-scroll-hold"),
        200,
      );
    };
    const realign = (anchor: Element, top: number) => {
      const shift = anchor.getBoundingClientRect().top - top;
      if (shift !== 0) {
        hold();
        window.scrollTo({ top: window.scrollY + shift, behavior: "instant" });
      }
    };
    const keepInPlace = (anchor: Element | null, change: () => void) => {
      const before = anchor?.getBoundingClientRect().top;
      change();
      if (!anchor || before === undefined) return;
      realign(anchor, before);
    };
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    // Fold a row's details away over a short animation. Each frame sets
    // the details' height and the scroll position together, so `anchor`
    // stays exactly still. Near the end of the page there may be nothing
    // left to scroll; the browser then caps the scroll and the page
    // settles smoothly instead of jumping.
    const ease = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    const fold = (card: HTMLElement, anchor: Element | null, extra = 0) => {
      const detail = card.querySelector<HTMLElement>(".work-card-detail");
      const top = anchor?.getBoundingClientRect().top;
      const finish = () => {
        setOpen(card, false);
        card.classList.remove("is-closing", "is-handoff");
        card.style.removeProperty("height");
        card.style.removeProperty("overflow");
        detail?.removeAttribute("style");
        if (anchor && top !== undefined) {
          realign(anchor, top - extra);
        }
        // What only a closed row shows (its small photo) fades in rather
        // than appearing at once.
        if (!calm.matches) {
          card.classList.add("is-settling");
          window.setTimeout(() => card.classList.remove("is-settling"), 450);
        }
      };
      if (!detail || calm.matches) {
        finish();
        return;
      }
      // Fold the whole row from its open height to the height it will
      // have once closed (measured now, without a paint), not just the
      // details to nothing: a closed row is laid out differently (its
      // small photo returns), and the difference used to land as a jump
      // when the fold finished.
      // Closing it for the measurement shortens the page, and the
      // browser clamps the scroll to fit; put the scroll back at once.
      const startY = window.scrollY;
      const height = card.offsetHeight;
      card.classList.remove("is-open");
      const closed = card.offsetHeight;
      card.classList.add("is-open");
      if (window.scrollY !== startY) {
        hold();
        window.scrollTo({ top: startY, behavior: "instant" });
      }
      const shrink = height - closed;
      card.classList.add("is-closing");
      // "clip", not "hidden": hidden would make the row a scroll box, and
      // the sticky figure would drop to the junction mid-fold.
      card.style.overflow = "clip";
      card.style.height = `${height}px`;
      detail.style.transition = "opacity 0.2s ease-out";
      detail.style.opacity = "0";
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 320, 1);
        const p = ease(t);
        card.style.height = `${height - shrink * p}px`;
        // Only a row below the details moves as they shrink.
        if (anchor && anchor !== card) {
          hold();
          window.scrollTo({
            top: startY - (shrink - extra) * p,
            behavior: "instant",
          });
        }
        if (t < 1) {
          requestAnimationFrame(step);
        } else {
          finish();
        }
      };
      requestAnimationFrame(step);
    };

    // Phones: a row opened low on the screen would open its photo below
    // the fold. Bring it up, smoothly and in step with the opening, until
    // its title sits just under the header (or the top of the screen).
    // Rows whose photo already shows are left where they are.
    const liftFor = (card: Element) => {
      if (split()) return 0;
      const photo = card.querySelector(".work-card-big");
      if (!photo) return 0;
      const view = window.visualViewport;
      const bottom = view ? view.offsetTop + view.height : window.innerHeight;
      if (photo.getBoundingClientRect().bottom <= bottom - 16) return 0;
      const header = document.querySelector("header");
      const under = header
        ? Math.max(0, header.getBoundingClientRect().bottom)
        : 0;
      return Math.max(0, card.getBoundingClientRect().top - (under + 8));
    };
    const glide = (dy: number) => {
      if (dy <= 0) return;
      const startY = window.scrollY;
      if (calm.matches) {
        hold();
        window.scrollTo({ top: startY + dy, behavior: "instant" });
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 450, 1);
        hold();
        window.scrollTo({ top: startY + dy * ease(t), behavior: "instant" });
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    // D3: set while the figure walks to a tapped row on its way in.
    let going = false;
    // Whether the click about to come was a finger or pen, not a mouse
    // or a key.
    let touched = false;
    const onDown = (event: PointerEvent) => {
      touched = event.pointerType !== "mouse";
    };
    const onClick = (event: MouseEvent) => {
      const wasTouch = touched;
      touched = false;
      const target = event.target as Element;
      if (target.closest(".work-card-cap")) {
        // Closing with the figure: hold the next row still so
        // the details fold up into their row just above the finger. The
        // last row has nothing below it, so it holds itself instead.
        const card = target.closest<HTMLElement>(".work-card");
        if (!card || card.classList.contains("is-closing")) return;
        fold(card, card.nextElementSibling ?? card);
        return;
      }
      // H9: the figure walks into the project before the page changes:
      // to "View project" at the foot, or, from the photo or the "View
      // project" by the facts, out along its line to the right.
      const view = target.closest<HTMLAnchorElement>(
        ".work-card-detail .work-card-more, .work-card-detail .work-card-big",
      );
      if (view && !split() && !calm.matches) {
        const cap = view
          .closest(".work-card")
          ?.querySelector<HTMLElement>(".work-card-cap");
        if (cap && !cap.classList.contains("is-leaving")) {
          event.preventDefault();
          // It walks to "View project" at the foot, to just before its
          // words, whichever way in was tapped.
          const card = view.closest(".work-card");
          const sign = card?.querySelector<HTMLElement>(
            ".work-card-actions > .work-card-more",
          );
          // The way a person would walk it: up the route first, then
          // right along the line to the sign, at one steady pace. The
          // sign stands on the line under it, so the figure keeps to that
          // line instead of rising to the words.
          const c = cap.getBoundingClientRect();
          const t = sign?.getBoundingClientRect();
          const line = sign?.closest(".work-card-actions");
          const y = line ? line.getBoundingClientRect().bottom : 0;
          const dx = t ? t.left - c.right : 0;
          const dy = t ? y - (c.top + c.height / 2) : 0;
          const run = Math.abs(dx) + Math.abs(dy);
          const time = Math.min(1100, Math.max(600, run * 1.6));
          cap.classList.add("is-leaving");
          cap.animate(
            [
              { transform: "translate(0, 0)" },
              {
                transform: `translate(0, ${dy}px)`,
                offset: run ? Math.abs(dy) / run : 0,
              },
              { transform: `translate(${dx}px, ${dy}px)` },
            ],
            { duration: time, easing: "linear", fill: "forwards" },
          );
          const stepper = window.setInterval(
            () => cap.classList.toggle("is-step"),
            120,
          );
          window.setTimeout(() => {
            window.clearInterval(stepper);
            navigate(view.href);
          }, time + 50);
          return;
        }
      }
      // Links inside the open details navigate as usual.
      if (target.closest(".work-card-detail")) return;
      const card = target.closest(".work-card");
      if (!card) return;
      event.preventDefault();
      // D3: the whole row is the way into its project. A row not yet in
      // the pane shows first. With a mouse (the pointer usually showed it
      // already) the page then changes, once the figure has walked to it. A touch screen has no hover, so there the first
      // tap only shows the row, and a tap on the shown row goes in.
      if (split()) {
        const href = card.querySelector<HTMLAnchorElement>("h2 a")?.href;
        if (!href || going) return;
        if (
          card.classList.contains("is-open") &&
          !list.classList.contains("is-idle")
        ) {
          navigate(href);
          return;
        }
        closeAll();
        setOpen(card, true);
        list.classList.remove("is-idle");
        if (wasTouch) return;
        if (calm.matches) {
          navigate(href);
          return;
        }
        going = true;
        window.setTimeout(() => navigate(href), 650);
        return;
      }
      const open = !card.classList.contains("is-open");
      // A row further down the route: the open row above folds away over
      // the same short animation as Close, the tapped row held still,
      // instead of everything above it changing at once.
      const prev = list.querySelector<HTMLElement>(
        ".work-card.is-open:not(.is-closing)",
      );
      if (
        open &&
        prev &&
        prev !== card &&
        prev.compareDocumentPosition(card) & Node.DOCUMENT_POSITION_FOLLOWING
      ) {
        prev.classList.add("is-handoff");
        setOpen(card, true);
        fold(prev, card, liftFor(card));
        onPlace();
        return;
      }
      // Hold the tapped row still while any other open row folds away.
      keepInPlace(card, () => {
        closeAll();
        setOpen(card, open);
      });
      if (open) glide(liftFor(card));
      if (open) onPlace();
    };
    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape" && !split()) closeAll();
    };

    // H9: the figure is sticky (CSS), so it rides the lit line with the
    // scroll itself, with no lag. Only its distance from the bottom is
    // set here: 20px above the visible bottom of the screen, which on
    // iPhone sits above Safari's toolbar while that is showing. That
    // changes only when the toolbar comes or goes, not on every scroll.
    const placeCap = () => {
      const view = window.visualViewport;
      const hidden = view
        ? Math.max(
            0,
            document.documentElement.clientHeight -
              (view.offsetTop + view.height),
          )
        : 0;
      list.style.setProperty("--cap-gap", `${Math.round(hidden) + 20}px`);
    };
    let placing = false;
    const onPlace = () => {
      if (placing) return;
      placing = true;
      requestAnimationFrame(() => {
        placing = false;
        placeCap();
      });
    };

    // H9: the figure steps while the page scrolls and faces the way it
    // is going; it stands still again shortly after scrolling stops.
    let walkY = window.scrollY;
    let walkLast = 0;
    let walkIdle = 0;
    const onWalk = () => {
      if (calm.matches) return;
      const cap = list.querySelector<HTMLElement>(
        ".work-card.is-open:not(.is-closing) .work-card-cap",
      );
      if (!cap) return;
      const y = window.scrollY;
      if (y !== walkY) cap.classList.toggle("is-left", y < walkY);
      walkY = y;
      const now = performance.now();
      if (now - walkLast > 140) {
        cap.classList.toggle("is-step");
        walkLast = now;
      }
      window.clearTimeout(walkIdle);
      walkIdle = window.setTimeout(() => cap.classList.remove("is-step"), 180);
    };

    // D3: pointing at a row shows it in the pane; the first row shows
    // until then.
    const showFirst = () => {
      if (!split()) return;
      if (!list.querySelector(".work-card.is-open")) {
        const first = list.querySelector(".work-card");
        if (first) setOpen(first, true);
      }
    };
    // A row takes the pane only once the pointer rests on it a moment,
    // and not while the pointer is heading right, toward the photo, so
    // crossing other rows on the way there does not swap it.
    let hoverTimer = 0;
    let hoverCard: Element | null = null;
    let lastX = 0;
    let lastY = 0;
    const swapLater = () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        if (!hoverCard || going) return;
        closeAll();
        setOpen(hoverCard, true);
        list.classList.remove("is-idle");
        hoverCard = null;
      }, 130);
    };
    const onHover = (event: PointerEvent) => {
      if (!split() || event.pointerType !== "mouse") return;
      window.clearTimeout(hoverTimer);
      const card = (event.target as Element).closest(".work-card");
      hoverCard =
        card &&
        (!card.classList.contains("is-open") ||
          list.classList.contains("is-idle"))
          ? card
          : null;
      if (hoverCard) swapLater();
    };
    const onAim = (event: PointerEvent) => {
      const dx = event.clientX - lastX;
      const dy = event.clientY - lastY;
      lastX = event.clientX;
      lastY = event.clientY;
      if (hoverCard && dx > 0 && dx > Math.abs(dy) * 0.5) swapLater();
    };
    const onLeave = () => {
      window.clearTimeout(hoverTimer);
      hoverCard = null;
    };

    // D3: one figure for the whole list, moved along the route to
    // the open row; it steps while moving and faces up or down.
    const walker = document.createElement("span");
    walker.className = "work-walker-d2";
    walker.setAttribute("aria-hidden", "true");
    const svg = list.querySelector(".work-card-cap .work-card-walker");
    if (svg) walker.append(svg.cloneNode(true));
    list.append(walker);
    let walkerY: number | null = null;
    let stepTimer = 0;
    let stopTimer = 0;
    let boredTimer = 0;
    const placeWalker = () => {
      const card = list.querySelector<HTMLElement>(".work-card.is-open");
      const num = card?.querySelector<HTMLElement>(".work-card-num");
      if (!split() || !card || !num) return;
      // Measured from where the row sits in the layout (offsetTop), not
      // where it is drawn: rows rise into place as the page opens
      // (Reveal), and the figure should neither ride nor walk that rise.
      const c = card.getBoundingClientRect();
      const n = num.getBoundingClientRect();
      const half = walker.offsetWidth / 2;
      const x = card.offsetLeft + n.left - c.left + n.width / 2 - half;
      // Idle: at the start of the route, where the line begins (the CSS
      // starts it 0.75rem above the first row).
      const rem = parseFloat(getComputedStyle(root).fontSize);
      const idle = list.classList.contains("is-idle");
      const y = idle
        ? card.offsetTop - 0.75 * rem - half
        : card.offsetTop + n.top - c.top + n.height / 2 - half;
      walker.style.setProperty("--wx", `${x}px`);
      walker.style.setProperty("--wy", `${y}px`);
      if (walkerY !== null && y !== walkerY && !idle && !calm.matches) {
        window.clearTimeout(boredTimer);
        walker.classList.remove("is-bored");
        walker.classList.toggle("is-left", y < walkerY);
        window.clearInterval(stepTimer);
        walker.classList.add("is-step");
        stepTimer = window.setInterval(
          () => walker.classList.toggle("is-step"),
          130,
        );
        // Once it arrives it turns back to face the project on the right,
        // and if no one goes in for a while it squats there and draws.
        window.clearTimeout(stopTimer);
        stopTimer = window.setTimeout(() => {
          window.clearInterval(stepTimer);
          walker.classList.remove("is-step", "is-left");
          boredTimer = window.setTimeout(
            () => walker.classList.add("is-bored"),
            5000,
          );
        }, 600);
      }
      walkerY = y;
    };
    const watchOpen = new MutationObserver(() => {
      placeWalker();
    });
    watchOpen.observe(list, {
      subtree: true,
      attributes: true,
      attributeFilter: ["class"],
    });
    window.addEventListener("resize", placeWalker);

    // Arriving on the page (or coming back to it), the open row and the
    // figure are set in place at once; only later changes animate.
    list.setAttribute("data-still", "");
    if (split()) list.classList.add("is-idle");
    showFirst();
    placeWalker();
    requestAnimationFrame(() =>
      requestAnimationFrame(() => list.removeAttribute("data-still")),
    );
    wide.addEventListener("change", showFirst);
    list.addEventListener("pointerover", onHover);
    list.addEventListener("pointerleave", onLeave);
    list.addEventListener("pointermove", onAim, { passive: true });
    window.addEventListener("scroll", onWalk, { passive: true });
    window.visualViewport?.addEventListener("resize", onPlace);
    window.visualViewport?.addEventListener("scroll", onPlace);
    list.addEventListener("pointerdown", onDown, { passive: true });
    list.addEventListener("click", onClick);
    document.addEventListener("keydown", onKey);
    wide.addEventListener("change", closeAll);
    document.addEventListener("astro:before-swap", closeAll, { once: true });
    cleanupList = () => {
      list.removeEventListener("pointerover", onHover);
      list.removeEventListener("pointerleave", onLeave);
      list.removeEventListener("pointermove", onAim);
      window.clearTimeout(hoverTimer);
      watchOpen.disconnect();
      window.removeEventListener("resize", placeWalker);
      window.clearInterval(stepTimer);
      window.clearTimeout(stopTimer);
      window.clearTimeout(boredTimer);
      walker.remove();
      wide.removeEventListener("change", showFirst);
      window.removeEventListener("scroll", onWalk);
      window.visualViewport?.removeEventListener("resize", onPlace);
      window.visualViewport?.removeEventListener("scroll", onPlace);
      list.removeEventListener("pointerdown", onDown);
      list.removeEventListener("click", onClick);
      document.removeEventListener("keydown", onKey);
      wide.removeEventListener("change", closeAll);
    };
  });
</script>
