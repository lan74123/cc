---
import Hamburger from "./Hamburger.astro";
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getImage } from "astro:assets";
import { CDN_FAVICON_URL } from "../consts";

export interface Props {
  is404Page?: boolean;
}

const { is404Page = false } = Astro.props;

const favicon_avif = await getImage({
  src: CDN_FAVICON_URL,
  alt: "favicon",
  width: 60,
  height: 60,
  decoding: "async",
  format: "avif",
});
---

<header class="relative mb-[20px] mt-[-10px]">
  <nav
    aria-label="Main navigation"
    class="flex items-center justify-between w-full h-[30px]"
  >
    {
      !is404Page && (
        <div class="flex items-center h-[30px]">
          <a href="/" class="block">
            <img
              class="favicon dark:invert w-[30px] h-[30px]"
              src={favicon_avif.src}
              alt="Home"
              width="30"
              height="30"
            />
          </a>
        </div>
      )
    }
    <div class="flex items-center h-[30px] gap-2">
      {
        !is404Page && (
          <>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <ThemeToggle />
            </div>
            <div class="flex items-center justify-center h-[30px] w-[30px]">
              <Hamburger />
            </div>
          </>
        )
      }
    </div>
  </nav>
  {!is404Page && <Navigation />}
  <slot />
</header>
