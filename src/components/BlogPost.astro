    html[data-desk="d1"]:is(
        [data-list="g1"],
        [data-list="h4-3"],
        [data-list="h5"],
        [data-list="h6"],
        [data-list="h8"],
        [data-list="h9"],
        [data-list="h10"],
        [data-list="h4"],
