        [data-list="h9"],
        [data-list="h10"]
      )
      .work-card-cap:active {
      color: rgb(34, 33, 37);
      background: rgb(245, 245, 245);
    }
    html[data-desk="d1"]:is([data-list="h8"], [data-list="h10"])
      .work-card-cap {
      position: absolute;
      left: calc(var(--rx) - var(--dx) - 1.375rem);
      bottom: -1.375rem;
    }
    html[data-desk="d1"][data-list="h9"] .work-card-cap {
      position: absolute;
      left: calc(var(--rx) - var(--dx) - 1.375rem);
      bottom: -1.375rem;
      transform: translate(var(--walk, 0px), var(--cap-lift, 0px));
    }
    html[data-desk="d1"] .work-card-walker {
      width: 2rem;
      height: 2rem;
      transition: transform 0.2s ease-out;
    }
    html[data-desk="d1"] .work-card-walker .walker-step,
    html[data-desk="d1"] .work-card-cap.is-step .walker-stand {
