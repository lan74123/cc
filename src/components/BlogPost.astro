        [data-list="h5"],
        [data-list="h6"],
        [data-list="h8"],
        [data-list="h9"],
        [data-list="h10"]
      )
      .work-card-close-bottom {
      display: inline-flex;
      margin-left: auto;
      padding: 0 0 3px;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: inherit;
      background: none;
      border: 0;
      border-bottom: 1px solid currentColor;
      opacity: 0.6;
